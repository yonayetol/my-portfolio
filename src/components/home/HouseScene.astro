<script>
  const initializeHouseScenes = () => {
    document.querySelectorAll<HTMLElement>(".house-scene").forEach((scene) => {
      if (scene.dataset.ready === "true") return;
      scene.dataset.ready = "true";
      let entryTimer: number | undefined;

      scene.querySelector<HTMLAnchorElement>(".gate-entry")?.addEventListener("click", () => {
        // Keep native anchor navigation immediate, including browser history and focus.
        window.clearTimeout(entryTimer);
        scene.classList.add("is-entering");
        entryTimer = window.setTimeout(() => scene.classList.remove("is-entering"), 850);
      });

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            scene.dataset.sceneVisible = String(Boolean(entry?.isIntersecting));
          },
          { threshold: 0 },
        );
        observer.observe(scene);
        document.addEventListener(
          "astro:before-swap",
          () => {
            observer.disconnect();
            window.clearTimeout(entryTimer);
          },
          { once: true },
        );
      }
    });
  };

  const updatePageVisibility = () => {
    document.documentElement.dataset.pageHidden = String(document.hidden);
  };
  document.addEventListener("visibilitychange", updatePageVisibility);
  document.addEventListener("astro:page-load", initializeHouseScenes);
  updatePageVisibility();
  initializeHouseScenes();
</script>

