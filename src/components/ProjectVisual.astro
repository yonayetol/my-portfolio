---
import type { ProjectVisual as VisualType } from "@/data/projects";
import { withBase } from "@/utils/paths";

interface Props {
  type: VisualType;
  compact?: boolean;
}

const { type, compact = false } = Astro.props;
---

<div
  class:list={["project-visual", `project-visual--${type}`, { "project-visual--compact": compact }]}
  aria-hidden="true"
>
  <div class="visual-grid"></div>

  {
    type === "infrastructure" && (
      <div class="ims-evidence">
        <img
          src={withBase("images/projects/nexora-ims-school-life.webp")}
          alt=""
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
        <div class="ims-evidence__topline">
          <span>
            <i /> PROJECT SCREENSHOT
          </span>
          <span>ABDI ADAMA SCHOOL / SCHOOL LIFE</span>
        </div>
        <div class="ims-evidence__readout">
          <span>PUBLIC INTERFACE</span>
          <strong>From system architecture to the screen people use.</strong>
          <small>ROLES → DATA → NOTIFICATIONS → DEPLOYMENT</small>
        </div>
        <span class="ims-evidence__index">DEPLOYED SCHOOL IMS</span>
      </div>
    )
  }

  {
    type === "pattern" && (
      <div class="pattern-map">
        <svg viewBox="0 0 600 360" role="presentation">
          <g class="pattern-lines">
            <path d="M76 186 181 86 291 173 394 76 512 165" />
            <path d="M76 186 190 276 291 173 401 282 512 165" />
            <path d="M181 86 190 276M394 76 401 282" />
          </g>
          <g class="pattern-nodes">
            <circle cx="76" cy="186" r="14" />
            <circle cx="181" cy="86" r="10" />
            <circle cx="190" cy="276" r="10" />
            <circle class="pattern-core" cx="291" cy="173" r="23" />
            <circle cx="394" cy="76" r="10" />
            <circle cx="401" cy="282" r="10" />
            <circle cx="512" cy="165" r="14" />
          </g>
        </svg>
        <span class="pattern-code pattern-code--a">min_support(p) ≥ τ</span>
        <span class="pattern-code pattern-code--b">expand ∧ score</span>
        <span class="visual-label">HYPERGRAPH PATTERN SEARCH</span>
      </div>
    )
  }

  {
    type === "donation" && (
      <div class="donation-product">
        <div class="donation-product__intro">
          <span>BERHAN · PRODUCT DIRECTION</span>
          <strong>Giving should feel clear before it asks for commitment.</strong>
          <small>IN-PROGRESS CONCEPT</small>
        </div>
        <div class="giving-preview">
          <div class="giving-preview__head">
            <div class="berhan-mark" aria-hidden="true">
              <span />
            </div>
            <div>
              <strong>Support a cause</strong>
              <small>Flexible giving, one calm flow</small>
            </div>
            <span class="prototype-pill">Prototype</span>
          </div>
          <div class="giving-progress" aria-hidden="true">
            <>
              <span class="is-active">Cause</span>
              <i />
            </>{" "}
            <>
              <span>Amount</span>
              <i />
            </>{" "}
            <span>Confirm</span>
          </div>
          <div class="giving-selection">
            <span>Selected cause</span>
            <strong>Choose where your support goes</strong>
            <small>One cause or a thoughtful split between several.</small>
          </div>
          <div class="giving-options">
            <>
              <span>Local supporter</span>
              <span>Diaspora supporter</span>
            </>
          </div>
          <div class="giving-toggle">
            <span>
              <>
                <strong>Give anonymously</strong>
                <small>Keep your identity private</small>
              </>
            </span>
            <i aria-hidden="true" />
          </div>
          <div class="giving-action">
            Continue securely <span aria-hidden="true">→</span>
          </div>
        </div>
        <div class="donation-product__features">
          <div>
            <>
              <span>Recurring support</span>
              <small>Designed for continued participation</small>
            </>
          </div>
          <div>
            <>
              <span>Donor choice</span>
              <small>Split, private, or direct giving</small>
            </>
          </div>
          <div>
            <>
              <span>Two contexts</span>
              <small>Local and diaspora paths</small>
            </>
          </div>
        </div>
      </div>
    )
  }

  {
    type === "learning" && (
      <div class="learning-map">
        <div class="learning-curve">
          <svg viewBox="0 0 560 260" role="presentation">
            <path class="axis" d="M46 28v196h472" />
            <path class="curve curve--ghost" d="M48 58c80 8 118 118 190 119 87 1 116-95 274-112" />
            <path
              class="curve"
              d="M48 194c72-2 84-92 154-93 68-1 90 74 148 72 62-2 84-88 162-115"
            />
            <g>
              <circle cx="48" cy="194" r="6" />
              <circle cx="202" cy="101" r="6" />
              <circle cx="350" cy="173" r="6" />
              <circle cx="512" cy="58" r="6" />
            </g>
          </svg>
        </div>
        <span class="learning-tag learning-tag--a">derive</span>
        <span class="learning-tag learning-tag--b">implement</span>
        <span class="learning-tag learning-tag--c">evaluate</span>
        <span class="visual-label">FROM-SCRATCH MODEL STUDY</span>
      </div>
    )
  }
</div>
