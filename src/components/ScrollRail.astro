---
interface SectionLink {
  id: string;
  index: string;
  label: string;
}

interface Props {
  sections: SectionLink[];
}

const { sections } = Astro.props;
---

<nav class="scroll-rail" aria-label="Jump between page sections" data-scroll-rail>
  <div class="scroll-rail__readout" aria-hidden="true">
    <span data-rail-current>{sections[0]?.index ?? "00"}</span>
    <i></i>
    <span>{sections.at(-1)?.index ?? "00"}</span>
  </div>

  <button
    type="button"
    class="scroll-rail__step"
    data-rail-step="previous"
    aria-label="Previous section"
  >
    <span aria-hidden="true">↑</span>
  </button>

  <div class="scroll-rail__routes">
    <span class="scroll-rail__track" aria-hidden="true"><i></i></span>
    {
      sections.map((section, index) => (
        <a
          href={`#${section.id}`}
          data-scroll-target={section.id}
          data-scroll-label={section.label}
          aria-label={`Jump to ${section.label}`}
          aria-current={index === 0 ? "location" : undefined}
        >
          <span>{section.index}</span>
          <i aria-hidden="true" />
          <small>{section.label}</small>
        </a>
      ))
    }
  </div>

  <button type="button" class="scroll-rail__step" data-rail-step="next" aria-label="Next section">
    <span aria-hidden="true">↓</span>
  </button>

  <span class="scroll-rail__active-label" data-rail-label aria-hidden="true">
    {sections[0]?.label ?? "Top"}
  </span>
</nav>

<script>
  const initScrollRail = () => {
    const rail = document.querySelector<HTMLElement>("[data-scroll-rail]");
    if (!rail || rail.dataset.ready === "true") return;
    rail.dataset.ready = "true";

    const links = [...rail.querySelectorAll<HTMLAnchorElement>("[data-scroll-target]")];
    const currentNode = rail.querySelector<HTMLElement>("[data-rail-current]");
    const labelNode = rail.querySelector<HTMLElement>("[data-rail-label]");
    const targets = links
      .map((link) => document.getElementById(link.dataset.scrollTarget ?? ""))
      .filter((section): section is HTMLElement => Boolean(section));

    let activeIndex = 0;

    const setActive = (id: string) => {
      const nextIndex = links.findIndex((link) => link.dataset.scrollTarget === id);
      if (nextIndex < 0) return;
      activeIndex = nextIndex;

      links.forEach((link, index) => {
        if (index === activeIndex) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });

      currentNode &&
        (currentNode.textContent = links[activeIndex]?.querySelector("span")?.textContent ?? "00");
      labelNode && (labelNode.textContent = links[activeIndex]?.dataset.scrollLabel ?? "Section");
    };

    let progressFrame = 0;
    const updateProgress = () => {
      progressFrame = 0;
      const available = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      rail.style.setProperty(
        "--rail-progress",
        String(Math.max(0, Math.min(1, scrollY / available))),
      );
    };
    const scheduleProgress = () => {
      if (progressFrame) return;
      progressFrame = requestAnimationFrame(updateProgress);
    };

    const jumpTo = (index: number) => {
      const boundedIndex = Math.max(0, Math.min(links.length - 1, index));
      const link = links[boundedIndex];
      if (!link) return;
      setActive(link.dataset.scrollTarget ?? "");
      link.click();
    };

    rail.querySelectorAll<HTMLButtonElement>("[data-rail-step]").forEach((button) => {
      button.addEventListener("click", () => {
        jumpTo(activeIndex + (button.dataset.railStep === "next" ? 1 : -1));
      });
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setActive(link.dataset.scrollTarget ?? ""));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setActive(visible.target.id);
      },
      { rootMargin: "-32% 0px -54%", threshold: [0, 0.1, 0.3, 0.6] },
    );

    targets.forEach((section) => observer.observe(section));
    window.addEventListener("scroll", scheduleProgress, { passive: true });
    window.addEventListener("resize", scheduleProgress);
    const hashTarget = window.location.hash.slice(1);
    setActive(
      hashTarget && targets.some((section) => section.id === hashTarget)
        ? hashTarget
        : (targets[0]?.id ?? ""),
    );
    updateProgress();
  };

  document.addEventListener("astro:page-load", initScrollRail);
  initScrollRail();
</script>
