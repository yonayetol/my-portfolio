<div class="chapter-flash" data-chapter-flash aria-hidden="true">
  <span class="chapter-flash__wipe" data-chapter-wipe></span>
  <span class="chapter-flash__index" data-chapter-index>00</span>
  <span class="chapter-flash__label" data-chapter-label>INTRO</span>
  <span class="chapter-flash__rule"></span>
</div>

<script>
  const initScrollChoreography = () => {
    const stage = document.querySelector<HTMLElement>("[data-chapter-flash]");
    const railLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-scroll-target]")];
    if (!stage || !railLinks.length || stage.dataset.ready === "true") return;
    stage.dataset.ready = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reducedMotion.matches) return;

    const chapters = railLinks
      .map((link) => ({
        element: document.getElementById(link.dataset.scrollTarget ?? ""),
        index: link.querySelector("span")?.textContent?.trim() ?? "00",
        label: link.dataset.scrollLabel?.toUpperCase() ?? "SECTION",
      }))
      .filter((chapter): chapter is typeof chapter & { element: HTMLElement } =>
        Boolean(chapter.element),
      );

    const indexNode = stage.querySelector<HTMLElement>("[data-chapter-index]");
    const labelNode = stage.querySelector<HTMLElement>("[data-chapter-label]");
    const wipeNode = stage.querySelector<HTMLElement>("[data-chapter-wipe]");
    let activeLabel = "";
    let hasInitialChapter = false;

    const activateChapter = (chapter: (typeof chapters)[number]) => {
      if (chapter.label === activeLabel) return;
      activeLabel = chapter.label;
      if (indexNode) indexNode.textContent = chapter.index;
      if (labelNode) labelNode.textContent = chapter.label;

      if (!hasInitialChapter) {
        hasInitialChapter = true;
        return;
      }

      [stage, indexNode, labelNode, wipeNode].forEach((node) =>
        node?.getAnimations().forEach((animation) => animation.cancel()),
      );

      stage.animate(
        [
          { opacity: 0, transform: "translate3d(0, 18vh, 0) scale(.92)" },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.18 },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.56 },
          { opacity: 0, transform: "translate3d(0, -16vh, 0) scale(1.06)" },
        ],
        { duration: 1450, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );

      indexNode?.animate(
        [
          { transform: "translate3d(-11vw, 3vh, 0) rotate(-7deg)" },
          { transform: "translate3d(0, 0, 0) rotate(0deg)", offset: 0.38 },
          { transform: "translate3d(8vw, -3vh, 0) rotate(4deg)" },
        ],
        { duration: 1450, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );

      labelNode?.animate(
        [
          { letterSpacing: "-.07em", filter: "blur(12px)", transform: "translate3d(7vw, 0, 0)" },
          {
            letterSpacing: "-.015em",
            filter: "blur(0)",
            transform: "translate3d(0, 0, 0)",
            offset: 0.42,
          },
          { letterSpacing: ".09em", filter: "blur(8px)", transform: "translate3d(-4vw, 0, 0)" },
        ],
        { duration: 1450, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );

      wipeNode?.animate(
        [
          { transform: "scaleX(0)", transformOrigin: "left" },
          { transform: "scaleX(1)", transformOrigin: "left", offset: 0.32 },
          { transform: "scaleX(1)", transformOrigin: "right", offset: 0.6 },
          { transform: "scaleX(0)", transformOrigin: "right" },
        ],
        { duration: 1150, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );
    };

    const chapterObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        const chapter = visible && chapters.find((item) => item.element === visible.target);
        if (chapter) activateChapter(chapter);
      },
      { rootMargin: "-45% 0px -45%", threshold: 0 },
    );

    const sceneSelectors = [
      "main > header",
      "main > section",
      ".case-study > header",
      ".case-study > section",
      ".project-card--feature",
      ".project-card--grid",
      ".decision-card",
      ".credential-group",
      ".principles-grid article",
      ".toolkit-table article",
    ];
    const scenes = [
      ...new Set(
        sceneSelectors.flatMap((selector) => [...document.querySelectorAll<HTMLElement>(selector)]),
      ),
    ];

    let animationFrame = 0;

    const renderScenes = () => {
      animationFrame = 0;
      const viewportHeight = window.innerHeight;
      const strength = window.innerWidth <= 800 ? 0.42 : 1;

      scenes.forEach((scene) => {
        const rect = scene.getBoundingClientRect();
        if (rect.bottom < -viewportHeight * 0.3 || rect.top > viewportHeight * 1.3) return;

        const progress = Math.max(
          0,
          Math.min(1, (viewportHeight - rect.top) / (viewportHeight + rect.height)),
        );
        const delta = progress - 0.5;
        const focus = 1 - Math.min(1, Math.abs(delta) * 1.6);

        scene.style.setProperty("--scene-progress", String(progress));
        scene.style.setProperty("--scene-focus", String(focus));
        scene.style.setProperty("--scene-sweep", `${progress * 100}%`);
        scene.style.setProperty("--scene-content-y", `${delta * -24 * strength}px`);
        scene.style.setProperty("--scene-y", `${delta * -92 * strength}px`);
        scene.style.setProperty("--scene-y-soft", `${delta * -48 * strength}px`);
        scene.style.setProperty("--scene-y-opposite", `${delta * 56 * strength}px`);
        scene.style.setProperty("--scene-heading-x", `${delta * -72 * strength}px`);
        scene.style.setProperty("--scene-media-y", `${delta * -42 * strength}px`);
        scene.style.setProperty("--scene-tilt", `${delta * -1.8 * strength}deg`);
        scene.style.setProperty("--scene-scale", String(1.01 + focus * 0.025));
        scene.style.setProperty(
          "--scene-opacity",
          String(Math.max(0.42, 1 - Math.max(0, progress - 0.67) * 1.7)),
        );
      });
    };

    const scheduleRender = () => {
      if (animationFrame) return;
      animationFrame = window.requestAnimationFrame(renderScenes);
    };

    document.documentElement.dataset.scrollFx = "true";
    scenes.forEach((scene) => scene.setAttribute("data-scroll-scene", ""));
    chapters.forEach((chapter) => chapterObserver.observe(chapter.element));
    renderScenes();

    window.addEventListener("scroll", scheduleRender, { passive: true });
    window.addEventListener("resize", scheduleRender);
  };

  document.addEventListener("astro:page-load", initScrollChoreography);
  initScrollChoreography();
</script>
