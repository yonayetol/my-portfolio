---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile, experience, socialLinks } from "@/data/profile";
import { projects } from "@/data/projects";
import { withBase } from "@/utils/paths";
---

<BaseLayout
  title="Yonas — The essentials"
  description="A quick look at Yonas’s engineering work, experience, and contact details."
>
  <main id="main-content" class="quick-page home-shell">
    <p class="home-eyebrow">THE HOME / QUICK VIEW</p><h1>Yonas.<br /><em>The essentials.</em></h1><p
      class="quick-intro"
    >
      {profile.role} · {profile.location}
    </p><p>{profile.support}</p>
    <div class="quick-actions">
      <a class="home-button" href={`mailto:${profile.email}`}>Get in touch ↗</a><a
        class="home-link"
        href={withBase()}>Explore the home ↗</a
      >
    </div>
    <section aria-labelledby="quick-work">
      <h2 id="quick-work">Selected work</h2>{
        projects.map((project) => (
          <a class="quick-record" href={withBase(`work/${project.slug}/`)}>
            <>
              <div>
                <>
                  <span class="home-eyebrow">{project.statusLabel}</span>
                  <h3>{project.title} ↗</h3>
                  <p>{project.summary}</p>
                </>
              </div>
              <span>{project.disciplines.slice(0, 3).join(" · ")}</span>
            </>
          </a>
        ))
      }
    </section>
    <section aria-labelledby="quick-experience">
      <h2 id="quick-experience">Experience & education</h2>{
        experience.map((item) => (
          <div class="quick-record">
            <>
              <div>
                <>
                  <h3>{item.organization}</h3>
                  <p>{item.detail}</p>
                </>
              </div>
              <span>{item.role}</span>
            </>
          </div>
        ))
      }
    </section>
    <section>
      <h2>Find me here</h2><nav aria-label="Public profiles" class="quick-actions">
        {
          socialLinks.map((link) => (
            <a class="home-link" href={link.href} target="_blank" rel="noreferrer">
              {link.label} ↗
            </a>
          ))
        }
      </nav><a class="home-link" href={`mailto:${profile.email}`}>{profile.email}</a>
    </section>
  </main>
</BaseLayout>
<style>
  .quick-page {
    max-width: 1050px;
    padding-top: 70px;
    padding-bottom: 75px;
  }
  .quick-page h1 {
    font: 64px/1.1 var(--font-serif);
    letter-spacing: -2px;
    margin: 20px 0;
  }
  .quick-page > p {
    max-width: 650px;
    color: var(--home-muted);
    font-size: 14px;
  }
  .quick-page .quick-intro {
    font-size: 16px;
    color: var(--home-ink);
    margin-bottom: 15px;
  }
  .quick-actions {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    margin: 27px 0;
  }
  .quick-page section {
    margin-top: 65px;
  }
  .quick-page h2 {
    font: 34px var(--font-serif);
    margin-bottom: 25px;
  }
  .quick-record {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 30px;
    padding: 25px 0;
    border-top: 1px solid var(--home-line);
  }
  .quick-record h3 {
    font: 24px var(--font-serif);
    margin: 8px 0;
  }
  .quick-record p {
    font-size: 12px;
    color: var(--home-muted);
  }
  .quick-record > span {
    font-size: 11px;
    color: var(--home-muted);
    align-self: center;
    text-align: right;
  }
  .quick-record:hover h3 {
    color: var(--home-blue);
  }
  @media (max-width: 600px) {
    .quick-page h1 {
      font-size: 51px;
    }
    .quick-record {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .quick-record > span {
      text-align: left;
    }
  }
</style>
