---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectVisual from "@/components/ProjectVisual.astro";
import { projects, type Project } from "@/data/projects";
import { withBase } from "@/utils/paths";
import "@/styles/interiors.css";
export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
}
const { project } = Astro.props;
const next =
  projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
const context = project.context.replace(
  "The supplied project record describes a platform",
  "I worked on a platform",
);
const scope = project.proof.filter(
  (item) => !item.includes("supplied project record") && item !== "Active in-progress status",
);
---

<BaseLayout title={`${project.title} · Yonas’s workshop`} description={project.summary}>
  <main id="main-content" class={`interior-page interior-case interior-case--${project.visual}`}>
    <header class="home-shell interior-heading" id="top">
      <a class="interior-breadcrumb" href={withBase("work/")}>← Back to the workshop</a>
      <div class="interior-case-label">
        <p class="home-eyebrow">From the workbench / {project.index}</p><span
          class={`interior-status interior-status--${project.status}`}>{project.statusLabel}</span
        >
      </div>
      <h1>{project.title}</h1>
      <div class="interior-case-intro">
        <p class="interior-deck">{project.statement}</p><div>
          <p>{project.summary}</p><ul class="interior-tags">
            {project.disciplines.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </header>
    <figure class="home-shell interior-case-visual">
      <ProjectVisual type={project.visual} /><figcaption>
        {
          project.visual === "infrastructure"
            ? "A view of the school’s public interface."
            : "An illustration of the project’s technical direction."
        }
      </figcaption>
    </figure>
    <section class="home-shell interior-case-section" id="system-context">
      <div><span class="interior-small">01 / THE CONTEXT</span></div><div>
        <h2>What needed<br /><em>figuring out.</em></h2><p class="interior-lead">{context}</p><p>
          {project.system}
        </p>
      </div>
    </section>
    <section class="interior-decision-section" id="engineering-decisions">
      <div class="home-shell">
        <div class="interior-section-heading">
          <p class="home-eyebrow">02 / The decisions</p><h2>
            The thinking<br />behind the making.
          </h2>
        </div><div class="interior-decisions">
          {
            project.decisions.map((decision, index) => (
              <article>
                <>
                  <span class="interior-decision-number">0{index + 1}</span>
                  <h3>{decision.title}</h3>
                  <p>{decision.detail}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="home-shell interior-case-section" id="evidence-record">
      <div><span class="interior-small">03 / SUPPORTED SCOPE</span></div><div>
        <h2>A closer look<br /><em>at the work.</em></h2><ol class="interior-scope">
          {
            scope.map((item, index) => (
              <li>
                <span>0{index + 1}</span>
                {item}
              </li>
            ))
          }
        </ol>{
          project.status === "in-progress" && (
            <p class="interior-note">
              This project is in progress. These entries describe its current scope and direction,
              not a claim that every proposed feature is live.
            </p>
          )
        }
      </div>
    </section>
    <section class="interior-reflection" id="reflection">
      <div class="home-shell">
        <p class="home-eyebrow">A note from the workbench</p><blockquote>
          {project.reflection}
        </blockquote><span class="interior-signature">Yonas</span>
      </div>
    </section>
    {
      next && (
        <aside class="home-shell interior-next">
          <>
            <div>
              <>
                <p class="home-eyebrow">Next on the workbench</p>
                <a href={withBase(`work/${next.slug}/`)}>
                  {next.title}
                  <span aria-hidden="true">↗</span>
                </a>
              </>
            </div>
            <a class="home-link" href={`${withBase()}#contact`}>
              Let’s build something →
            </a>
          </>
        </aside>
      )
    }
  </main>
</BaseLayout>
