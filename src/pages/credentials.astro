---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CredentialViewer from "@/components/CredentialViewer.astro";
import CodingPractice from "@/components/home/CodingPractice.astro";
import CourseNotebook from "@/components/home/CourseNotebook.astro";
import { credentialCategories, credentials } from "@/data/credentials";
import { courses } from "@/data/courses";
import { codingProfile } from "@/data/profile";
import { withBase } from "@/utils/paths";
import "@/styles/interiors.css";
---

<BaseLayout
  title="The reading nook · Credentials by Yonas"
  description="A shelf of learning records in mathematics, machine learning, deep learning, NLP, and applied AI."
>
  <main id="main-content" class="interior-page">
    <header class="home-shell interior-heading" id="top">
      <a class="interior-breadcrumb" href={withBase()}>← Back to the courtyard</a><p
        class="home-eyebrow"
      >
        Room 05 / The reading nook
      </p><div class="interior-heading-row">
        <h1>Always a<br /><em>student.</em></h1><div>
          <p>
            A small shelf of formal checkpoints along a self-directed path. Mathematics, machine
            learning, and the ideas I keep coming back to.
          </p><span class="interior-small"
            >{credentials.length} RECORDS · {credentialCategories.length} LEARNING TRACKS</span
          >
        </div>
      </div>
    </header>
    <section
      class="home-shell course-collection"
      id="course-notebooks"
      aria-labelledby="course-collection-title"
    >
      <div class="course-collection__intro">
        <p class="home-eyebrow">Notes from the reading nook</p>
        <h2 id="course-collection-title">Open a book.<br /><em>Try an idea.</em></h2>
        <p>
          Seven course notebooks, from the geometry of a vector to the size of a learning step. Each
          pairs the course topics with a small interactive example.
        </p>
      </div>
      <div class="course-collection__books">
        {
          courses.map((course, index) => (
            <details
              class="course-collection__book"
              id={course.id}
              style={`--book-color: ${course.color}`}
            >
              <summary>
                <span class="course-collection__spine" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="course-collection__name">
                  <>
                    <strong>{course.shortTitle}</strong>
                    <small>Course notebook · interactive example</small>
                  </>
                </span>
                <span class="course-collection__open" aria-hidden="true">
                  +
                </span>
              </summary>
              <div class="course-collection__pages">
                <p class="course-collection__full-title">{course.title}</p>
                <CourseNotebook course={course} />
              </div>
            </details>
          ))
        }
      </div>
    </section>
    <section class="home-shell interior-credentials" aria-label="Learning records">
      {
        credentialCategories.map((category, i) => (
          <section
            id={`credential-track-${i}`}
            class="interior-credential-group"
            aria-labelledby={`category-${i}`}
          >
            <>
              <header>
                <>
                  <span class="interior-book-spine" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <div>
                    <>
                      <p class="home-eyebrow">Shelf 0{i + 1}</p>
                      <h2 id={`category-${i}`}>{category}</h2>
                    </>
                  </div>
                  <span class="interior-small">
                    {credentials.filter((item) => item.category === category).length} RECORDS
                  </span>
                </>
              </header>
              <ol>
                {credentials
                  .filter((item) => item.category === category)
                  .map((credential) => (
                    <li>
                      <span class="interior-small">
                        {String(credentials.indexOf(credential) + 1).padStart(2, "0")}
                      </span>
                      <div>
                        <h3>{credential.title}</h3>
                        <span>{credential.provider}</span>
                      </div>
                      <a
                        href={credential.href}
                        target="_blank"
                        rel="noreferrer"
                        data-credential-open={credentials.indexOf(credential)}
                        aria-label={`Preview ${credential.title}`}
                      >
                        View record <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
              </ol>
            </>
          </section>
        ))
      }
    </section>
    <section class="interior-practice-note" id="practice">
      <div class="home-shell interior-practice-grid">
        <div>
          <p class="home-eyebrow">A page from the practice notebook</p><h2>
            Small problems.<br /><em>Stronger foundations.</em>
          </h2><p>
            Algorithm practice is part of how I keep my reasoning sharp. A notebook of steady
            practice, one solved problem and one new approach at a time.
          </p><a class="home-link" href={codingProfile.href} target="_blank" rel="noreferrer"
            >Visit my LeetCode profile ↗</a
          >
        </div><CodingPractice />
      </div>
    </section>
    <aside class="home-shell interior-endnote">
      <span class="home-eyebrow">Keep following the thread</span><p>
        The certificates mark a checkpoint. The workshop shows how that learning turns into ideas,
        experiments, and useful systems.
      </p><a class="home-link" href={withBase("work/")}>Step into the workshop →</a>
    </aside>
    <CredentialViewer />
  </main>
</BaseLayout>

<script>
  const openLinkedNotebook = () => {
    const notebook = document.getElementById(window.location.hash.slice(1));
    if (
      notebook instanceof HTMLDetailsElement &&
      notebook.classList.contains("course-collection__book")
    ) {
      notebook.open = true;
    }
  };
  openLinkedNotebook();
  window.addEventListener("hashchange", openLinkedNotebook);
</script>

<style>
  .course-collection {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 72px;
    padding-bottom: 84px;
  }
  .course-collection__intro {
    padding-top: 16px;
  }
  .course-collection__intro h2 {
    margin: 16px 0 24px;
    color: var(--home-ink, #29362d);
    font:
      54px/1.08 Georgia,
      serif;
    letter-spacing: -0.04em;
  }
  .course-collection__intro h2 em {
    color: var(--home-green, #315343);
    font-weight: normal;
  }
  .course-collection__intro > p:last-child {
    max-width: 345px;
    color: var(--home-muted, #697166);
    font-size: 14px;
    line-height: 1.9;
  }
  .course-collection__books {
    min-width: 0;
    border-top: 1px solid var(--home-line, #d9dacd);
  }
  .course-collection__book {
    border-bottom: 1px solid var(--home-line, #d9dacd);
    scroll-margin-top: 120px;
  }
  .course-collection__book summary {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 94px;
    padding: 16px 5px;
    list-style: none;
    cursor: pointer;
  }
  .course-collection__book summary::-webkit-details-marker {
    display: none;
  }
  .course-collection__book summary:focus-visible {
    outline: 2px solid var(--home-blue, #3159be);
    outline-offset: 4px;
    border-radius: 3px;
  }
  .course-collection__spine {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 51px;
    flex: 0 0 32px;
    border-radius: 2px 4px 4px 2px;
    border-left: 3px solid #ffffff24;
    background: var(--book-color);
    color: #fff9ef;
    font: 10px var(--font-mono, monospace);
    box-shadow: 2px 2px 0 #00000010;
  }
  .course-collection__name {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 7px;
  }
  .course-collection__name strong {
    color: var(--home-ink, #29362d);
    font:
      21px/1.2 Georgia,
      serif;
  }
  .course-collection__name small {
    color: var(--home-muted, #697166);
    font-size: 9px;
    line-height: 1.5;
  }
  .course-collection__open {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border: 1px solid var(--home-line, #d9dacd);
    border-radius: 50%;
    color: var(--home-green, #315343);
    font-size: 19px;
  }
  .course-collection__book[open] .course-collection__open {
    transform: rotate(45deg);
  }
  .course-collection__pages {
    max-width: 500px;
    padding: 3px 0 30px;
    margin: auto;
  }
  .course-collection__full-title {
    margin: 0 0 17px;
    color: var(--home-ink, #29362d);
    font:
      23px/1.3 Georgia,
      serif;
  }
  @media (max-width: 800px) {
    .course-collection {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-bottom: 58px;
    }
    .course-collection__intro h2 {
      font-size: 43px;
    }
    .course-collection__intro > p:last-child {
      max-width: 500px;
    }
    .course-collection__pages {
      max-width: none;
    }
  }
  @media (max-width: 400px) {
    .course-collection__book summary {
      gap: 11px;
    }
    .course-collection__name strong {
      font-size: 19px;
    }
    .course-collection__intro h2 {
      font-size: 37px;
    }
  }
</style>
