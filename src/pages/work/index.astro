---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectVisual from "@/components/ProjectVisual.astro";
import { projects } from "@/data/projects";
import { withBase } from "@/utils/paths";
import "@/styles/interiors.css";
const statuses = [...new Set(projects.map((project) => project.status))];
const statusLabels = { shipped: "Shipped", "in-progress": "In progress", research: "Research" };
---

<BaseLayout
  title="The workshop · Projects by Yonas"
  description="Step inside Yonas’s workshop. Production software, symbolic AI, school management, and digital examination."
>
  <main id="main-content" class="interior-page">
    <header class="home-shell interior-heading" id="top">
      <a class="interior-breadcrumb" href={withBase()}>← Back to the courtyard</a>
      <p class="home-eyebrow">Room 02 / The workshop</p>
      <div class="interior-heading-row">
        <h1>Made with<br /><em>intention.</em></h1><div>
          <p>
            Some things are out in the world. Others are still taking shape. Here’s what’s on my
            workbench—and the thinking behind it.
          </p><span class="interior-small">{projects.length} PROJECTS · ALWAYS BUILDING</span>
        </div>
      </div>
    </header>
    <section class="home-shell interior-work" aria-label="Project collection">
      <div class="interior-filter" data-work-filter>
        <span class="interior-small">On the workbench</span>
        <div role="group" aria-label="Filter projects by status" hidden>
          <button type="button" data-filter="all" aria-pressed="true">Everything</button>
          {
            statuses.map((status) => (
              <button type="button" data-filter={status} aria-pressed="false">
                {statusLabels[status]}
              </button>
            ))
          }
        </div>
        <p class="sr-only" aria-live="polite" data-filter-status>
          Showing all {projects.length} projects.
        </p>
      </div>
      <div class="interior-projects">
        {
          projects.map((project) => (
            <article
              class={`interior-project interior-project--${project.visual}`}
              data-project-card
              data-status={project.status}
            >
              <a
                href={withBase(`work/${project.slug}/`)}
                class="interior-project-art"
                aria-label={`Read about ${project.title}`}
              >
                {project.visual === "infrastructure" ? (
                  <img
                    src={withBase("images/projects/nexora-ims-school-life.webp")}
                    alt="Nexora IMS school life interface"
                    width="1600"
                    height="900"
                    loading="lazy"
                  />
                ) : project.visual === "management" || project.visual === "examination" ? (
                  <ProjectVisual type={project.visual} compact />
                ) : (
                  <svg viewBox="0 0 600 320" aria-hidden="true">
                    {project.visual === "pattern" && (
                      <>
                        <g fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M110 170 220 80 320 165 420 70 505 175 405 265 320 165 210 250 110 170M220 80 210 250M420 70 405 265" />
                          <circle cx="320" cy="165" r="58" stroke-dasharray="4 7" />
                        </g>
                        <g fill="currentColor">
                          <circle cx="110" cy="170" r="11" />
                          <circle cx="220" cy="80" r="8" />
                          <circle cx="320" cy="165" r="19" />
                          <circle cx="420" cy="70" r="8" />
                          <circle cx="505" cy="175" r="11" />
                          <circle cx="405" cy="265" r="8" />
                          <circle cx="210" cy="250" r="8" />
                        </g>
                      </>
                    )}
                  </svg>
                )}
                <>
                  <span class="interior-art-number">{project.index}</span>
                  <span class="interior-art-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </a>
              <div class="interior-project-meta">
                <>
                  <span>{project.eyebrow}</span>
                  <span class={`interior-status interior-status--${project.status}`}>
                    {project.statusLabel}
                  </span>
                </>
              </div>
              <h2>
                <a href={withBase(`work/${project.slug}/`)}>{project.title}</a>
              </h2>
              <p>{project.summary}</p>
              <ul class="interior-tags">
                {project.disciplines.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
    <aside class="home-shell interior-endnote">
      <span class="home-eyebrow">A little context</span><p>
        Work in progress means exactly that. I share the direction, decisions, and supported scope
        of each project, with room for the unfinished parts.
      </p><a class="home-link" href={`${withBase()}#kitchen`}>See what’s cooking →</a>
    </aside>
  </main>
</BaseLayout>
<script>
  const filter = document.querySelector<HTMLElement>("[data-work-filter]");
  if (filter) {
    const buttons = filter.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        let count = 0;
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        cards.forEach((card) => {
          const show =
            button.dataset.filter === "all" || card.dataset.status === button.dataset.filter;
          card.hidden = !show;
          if (show) count++;
        });
        const status = filter.querySelector("[data-filter-status]");
        if (status)
          status.textContent = `Showing ${count} ${count === 1 ? "project" : "projects"}.`;
      }),
    );
    filter.querySelector<HTMLElement>('[role="group"]')?.removeAttribute("hidden");
  }
</script>

<style>
  .interior-project-art :global(.project-visual--management),
  .interior-project-art :global(.project-visual--examination) {
    position: absolute;
    inset: 0;
    min-height: 0;
  }
  .interior-project-art :global(.systems-exhibit) {
    padding: 20px 15px;
  }
  .interior-project-art :global(.systems-exhibit svg) {
    max-height: 70%;
  }
  .interior-project-art :global(.systems-exhibit__caption) {
    font-size: 12px;
    margin-bottom: 5px;
  }
  .interior-project-art :global(.systems-exhibit small) {
    display: none;
  }
  .interior-project-art :global(.systems-exhibit__eyebrow) {
    font-size: 7px;
  }
</style>
