---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HouseScene from "@/components/home/HouseScene.astro";
import RoomIllustration from "@/components/home/RoomIllustration.astro";
import { profile, learning } from "@/data/profile";
import { projects } from "@/data/projects";
import { withBase } from "@/utils/paths";
const rooms = [
  ["01", "Main room", "A little about me", "#main-room"],
  ["02", "Workshop", "Things I’ve built", "#workshop"],
  ["03", "Kitchen", "What’s cooking", "#kitchen"],
  ["04", "Garden", "Always growing", "#garden"],
  ["05", "Reading nook", "Collected learning", withBase("credentials/")],
  ["06", "Veranda", "A conversation", "#contact"],
];
const topics = [
  {
    id: "reasoning",
    title: "Symbolic reasoning",
    note: "In the workshop",
    description:
      "Represent knowledge, connect ideas, and find patterns worth noticing. My work with Hyperon explores how a system can reason over what it knows.",
    project: "MM2 Pattern Miner",
    slug: "mm2-pattern-miner",
    tags: ["Hyperon", "MeTTa", "Pattern mining"],
  },
  {
    id: "learning",
    title: "Machine learning",
    note: "Established roots",
    description:
      "Start with the mathematics. Implement the algorithm. Test what it actually learned. My learning practice connects studied foundations to hands-on experiments.",
    project: "ML Engineering Dojo",
    slug: "ml-engineering-dojo",
    tags: ["Regression", "Model evaluation", "PyTorch"],
  },
  {
    id: "building",
    title: "Production systems",
    note: "Out in the world",
    description:
      "Good software needs more than a working model. Data, permissions, deployment, and the conditions people actually use it in all belong to the same system.",
    project: "Nexora IMS",
    slug: "nexora-ims",
    tags: ["PostgreSQL", "Docker", "Linux"],
  },
];
---

<BaseLayout
  title="Yonas — A home for ideas, a workshop for what’s next"
  description="Step into Yonas’s little home on the web. Explore AI engineering, real-world software, work in progress, and ideas taking root in Addis Ababa."
>
  <main id="main-content">
    <section class="home-arrival home-shell" aria-labelledby="welcome-title">
      <div class="arrival-copy">
        <p class="home-eyebrow"><span class="home-dot"></span> ADDIS ABABA, ETHIOPIA</p>
        <h1 id="welcome-title">
          A curious mind.<br />An open door<span class="heading-dot">.</span>
        </h1>
        <p class="arrival-intro">
          Hey, I’m <strong>Yonas.</strong> An AI engineer, software builder, and a firm believer that
          good things start with curiosity.
        </p>
        <p class="arrival-welcome">
          Welcome to my little home on the internet.<br />Come in. There’s a lot taking shape here.
        </p>
        <div class="arrival-actions">
          <a class="home-button" href="#workshop"
            >Explore my work <span aria-hidden="true">↗</span></a
          ><a class="home-link" href="#main-room">Come inside <span aria-hidden="true">→</span></a>
        </div>
        <div class="arrival-note">
          <svg width="42" height="35" viewBox="0 0 42 35" fill="none" aria-hidden="true"
            ><path
              d="M2 3c21-7 10 26 35 19m-9-7 10 7-9 8"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"></path></svg
          ><span>Every room has a story.<br />Make yourself at home.</span>
        </div>
      </div>
      <div class="arrival-scene">
        <div class="scene-caption">
          <span class="caption-line"></span> A HOME FOR IDEAS & THE THINGS THEY BECOME
        </div><HouseScene /><div class="scene-bottom">
          <span><i class="home-dot"></i> A little world. A work in progress.</span><button
            type="button"
            data-map-open>Take a look around <span aria-hidden="true">⌘</span></button
          >
        </div>
      </div>
    </section>
    <nav class="room-directory home-shell" aria-label="Explore the rooms">
      {
        rooms.map(([n, title, desc, url]) => (
          <a href={url}>
            <>
              <span class="directory-number">{n}</span>
              <strong>
                {title}
                <span aria-hidden="true">↗</span>
              </strong>
              <small>{desc}</small>
            </>
          </a>
        ))
      }
    </nav>
    <section
      id="main-room"
      class="home-room main-room home-shell"
      aria-labelledby="main-room-title"
    >
      <div class="main-room-photo" data-home-reveal>
        <div class="portrait-frame">
          <img
            src={withBase("images/yonas-portrait-small.webp")}
            alt="Yonas"
            width="900"
            height="1200"
            loading="lazy"
          /><span class="photo-tape"></span>
        </div><span class="portrait-caption">the person behind the projects.</span><svg
          class="portrait-sprig"
          viewBox="0 0 80 140"
          fill="none"
          aria-hidden="true"
          ><path
            d="M39 137c-4-57 3-87 27-124M40 100 12 76M42 77l28-19M49 51 32 29"
            stroke="currentColor"
            stroke-width="2"></path><path
            d="M11 76C-4 44 37 49 39 99M70 58c15-32-28-22-28 19M32 29c-5-25 30-20 17 22"
            fill="currentColor"></path></svg
        >
      </div>
      <div class="main-room-copy" data-home-reveal>
        <p class="home-eyebrow">01 / THE MAIN ROOM · ABOUT ME</p><h2 id="main-room-title">
          A builder at heart.<br />A learner, always.
        </h2><p>
          I’m drawn to the space between <em>“what if?”</em> and something that actually works. Sometimes
          that’s a symbolic AI system. Sometimes it’s software that makes a school’s day a little easier.
        </p><p>
          From co-founding Nexora to programming and teaching at iCog Labs, the thread is the same:
          understand deeply, build thoughtfully, and share what I learn.
        </p><div class="main-room-roles">
          <span>Nexora <small>Co-founder</small></span><span
            >iCog Labs <small>Programmer & trainer</small></span
          ><span>A2SV <small>Generation 6 alumnus</small></span>
        </div><a class="home-link" href={withBase("about/")}
          >A little more about me <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <section id="workshop" class="home-workshop home-room" aria-labelledby="workshop-title">
      <div class="home-shell">
        <div class="home-section-heading" data-home-reveal>
          <div>
            <p class="home-eyebrow">02 / THE WORKSHOP · SELECTED WORK</p><h2 id="workshop-title">
              Ideas, with their<br /><em>sleeves rolled up.</em>
            </h2>
          </div><div>
            <p>
              A few things I’ve taken from a question<br class="desktop-break" /> to code, systems, and
              the real world.
            </p><a class="home-link" href={withBase("work/")}>See everything on the workbench ↗</a>
          </div>
        </div>
        <div class="home-project-grid">
          {
            projects.slice(0, 3).map((project, index) => (
              <a
                class:list={["home-project", `home-project-${index}`]}
                href={withBase(`work/${project.slug}/`)}
                data-home-reveal
              >
                <div class="home-project-art">
                  <span class="project-art-index">OBJECT / 0{index + 1}</span>
                  {index === 0 ? (
                    <div class="project-browser">
                      <div class="project-browser-bar">
                        <i />
                        <i />
                        <i />
                        <span>nexora / school operations</span>
                      </div>
                      <img
                        src={withBase("images/projects/nexora-ims-school-life-small.webp")}
                        alt="Nexora IMS school website"
                        width="1600"
                        height="900"
                        loading="lazy"
                      />
                    </div>
                  ) : index === 1 ? (
                    <svg class="project-graph-art" viewBox="0 0 360 230" aria-hidden="true">
                      <g fill="none" stroke="#6a7d5e" stroke-width="1.5">
                        <path d="m51 130 76-78 65 75 64-87 57 89-57 58-64-60-65 67-76-64Zm76-78v142m129-154v147M51 130l141-3 121 2" />
                        <ellipse
                          cx="182"
                          cy="124"
                          rx="159"
                          ry="83"
                          stroke-dasharray="3 7"
                          opacity=".3"
                        />
                      </g>
                      {[
                        [51, 130],
                        [127, 52],
                        [127, 194],
                        [192, 127],
                        [256, 40],
                        [256, 187],
                        [313, 129],
                      ].map(([x, y], i) => (
                        <g>
                          <circle
                            cx={x}
                            cy={y}
                            r={i === 3 ? 24 : 12}
                            fill={i === 3 ? "#315343" : "#f6f2e9"}
                            stroke="#315343"
                            stroke-width="1.5"
                          />
                          <circle cx={x} cy={y} r="3" fill={i === 3 ? "#f6f2e9" : "#b9674f"} />
                        </g>
                      ))}
                    </svg>
                  ) : (
                    <div class="berhan-object">
                      <span class="berhan-sun" aria-hidden="true">
                        ✳
                      </span>
                      <strong>berhan</strong>
                      <span>Small acts. Shared light.</span>
                      <div class="berhan-path" aria-hidden="true">
                        <i />
                        <b />
                        <i />
                        <b />
                        <i />
                      </div>
                    </div>
                  )}
                  <span class="project-art-note">
                    {index === 0
                      ? "Built for real school days."
                      : index === 1
                        ? "Finding patterns in the possibility."
                        : "A more connected way to give."}
                  </span>
                </div>
                <>
                  <div class="home-project-meta">
                    <>
                      <span
                        class:list={[
                          "home-project-status",
                          { "is-shipped": project.status === "shipped" },
                        ]}
                      >
                        <i />
                        {project.statusLabel}
                      </span>
                      <span>0{index + 1} ↗</span>
                    </>
                  </div>
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                  <div class="home-project-tags">
                    {project.disciplines.slice(0, 3).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>
    <section id="kitchen" class="home-room home-kitchen home-shell" aria-labelledby="kitchen-title">
      <div class="kitchen-intro" data-home-reveal>
        <p class="home-eyebrow">03 / THE KITCHEN · IN PROGRESS</p><h2 id="kitchen-title">
          Something good<br />is <em>cooking.</em>
        </h2><p>
          Not everything is ready to serve.<br />Here’s what’s getting my attention.
        </p><RoomIllustration kind="kitchen" />
      </div>
      <div class="recipe-board" data-home-reveal>
        <div class="recipe-board-heading">
          <span class="home-eyebrow">ON THE STOVE</span><span>Two recipes in progress</span>
        </div>
        {
          projects
            .filter((p) => p.status === "in-progress")
            .map((project, index) => (
              <details class="home-recipe" open={index === 0}>
                <>
                  <summary>
                    <>
                      <span class="recipe-number">0{index + 1}</span>
                      <span>
                        <>
                          <small>
                            {index === 0 ? "A LITTLE REASONING" : "A LITTLE CONNECTION"}
                          </small>
                          <strong>{project.title}</strong>
                        </>
                      </span>
                      <span class="recipe-plus" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="recipe-body">
                    <>
                      <p>
                        {index === 0
                          ? "Finding meaningful patterns in a hypergraph. A mix of symbolic reasoning, careful filtering, and asking what makes a pattern surprising."
                          : "Building a calmer way for local and diaspora donors to support Ethiopian charities. Flexible giving, with trust at the center."}
                      </p>
                      <span class="recipe-label">THE INGREDIENTS</span>
                      <div class="recipe-ingredients">
                        {project.disciplines.slice(0, 4).map((tag) => (
                          <span>{tag}</span>
                        ))}
                      </div>
                      <a class="home-link" href={withBase(`work/${project.slug}/`)}>
                        Open the recipe ↗
                      </a>
                    </>
                  </div>
                </>
              </details>
            ))
        }
        <p class="recipe-footnote">A peek at the process. Both projects are in progress.</p>
      </div>
    </section>
    <section id="garden" class="home-garden home-room" aria-labelledby="garden-title">
      <div class="home-shell garden-layout">
        <div data-home-reveal>
          <p class="home-eyebrow">04 / THE GARDEN · LEARNING</p><h2 id="garden-title">
            Good things<br />take <em>growing.</em>
          </h2><p>
            Some ideas have deep roots. Others are just<br class="desktop-break" /> beginning to reach
            for the light.
          </p><RoomIllustration kind="garden" /><span class="garden-handnote"
            >a little tending, every day.</span
          >
        </div><div class="garden-notebook" data-home-reveal>
          <p class="home-eyebrow">FROM AN IDEA TO SOMETHING REAL</p><h3>
            Follow a growing thread.
          </h3><div class="garden-topics" role="group" aria-label="Explore learning connections">
            {
              topics.map((topic, i) => (
                <button
                  type="button"
                  data-garden-topic={topic.id}
                  aria-pressed={i === 0}
                  aria-controls={`garden-${topic.id}`}
                >
                  <span>0{i + 1}</span>
                  {topic.title}
                  <span aria-hidden="true">↗</span>
                </button>
              ))
            }
          </div>{
            topics.map((topic, i) => (
              <div
                class="garden-topic-panel"
                id={`garden-${topic.id}`}
                data-garden-panel={topic.id}
                hidden={i !== 0}
              >
                <>
                  <span class="garden-panel-note">{topic.note}</span>
                  <p>{topic.description}</p>
                  <div class="recipe-ingredients">
                    {topic.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <a class="garden-evidence" href={withBase(`work/${topic.slug}/`)}>
                    <>
                      <span class="garden-thread" aria-hidden="true" />
                      <small>GROWING THROUGH</small>
                      <strong>{topic.project} ↗</strong>
                    </>
                  </a>
                </>
              </div>
            ))
          }<noscript
            ><p>
              Explore the <a href={withBase("work/")}>workshop</a> for all learning connections.
            </p></noscript
          ><div class="garden-current">
            <span>Currently exploring</span><p>{learning.current.slice(0, 4).join(" · ")}</p>
          </div>
        </div>
      </div>
    </section>
    <section class="home-reading home-shell" aria-labelledby="reading-title">
      <div class="reading-books" aria-hidden="true">
        <span>MATHEMATICS</span><span>REASONING</span><span>LEARN & BUILD</span><i></i>
      </div><div>
        <p class="home-eyebrow">05 / THE READING NOOK</p><h2 id="reading-title">
          A few things from the bookshelf.
        </h2><p>
          Formal learning, mathematical foundations, and a steady practice of solving problems.
        </p>
      </div><a class="home-link" href={withBase("credentials/")}>Browse the collection ↗</a>
    </section>
    <section id="contact" class="home-contact home-room" aria-labelledby="contact-title">
      <div class="home-shell contact-layout">
        <div data-home-reveal>
          <p class="home-eyebrow">06 / THE VERANDA · LET’S TALK</p><h2 id="contact-title">
            There’s room for<br />another <em>good idea.</em>
          </h2><p>
            A project to build? A question to explore?<br />Or just a hello. I’d love to hear from
            you.
          </p><a class="home-button" href={`mailto:${profile.email}`}
            >Pull up a chair <span aria-hidden="true">↗</span></a
          ><div class="contact-email">
            <a href={`mailto:${profile.email}`}>{profile.email}</a><button
              type="button"
              data-copy-email={profile.email}
              aria-label="Copy email address"
              ><svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><rect
                  x="8"
                  y="8"
                  width="12"
                  height="12"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.5"></rect><path
                  d="M15 8V4H4v11h4"
                  stroke="currentColor"
                  stroke-width="1.5"></path></svg
              ></button
            >
          </div><p class="copy-status" aria-live="polite" data-copy-status></p>
        </div><div class="contact-art" data-home-reveal>
          <RoomIllustration kind="contact" /><span>good conversations grow good things.</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
