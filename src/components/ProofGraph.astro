<section class="proof-graph" aria-labelledby="graph-title" data-proof-graph data-reveal>
  <div class="proof-graph__canvas">
    <div class="proof-graph__intro">
      <span class="mono">Capabilities, grounded in work</span>
      <p>Select a practice to see the project evidence behind it.</p>
    </div>

    <div class="proof-tabs" role="tablist" aria-label="Capability evidence">
      <button
        class="proof-tab"
        type="button"
        role="tab"
        data-graph-node="reasoning"
        aria-selected="true"
        aria-controls="capability-evidence"
      >
        <span>Reasoning systems</span>
        <strong>Symbolic structures and pattern search</strong>
        <small>Demonstrated in MM2 Pattern Miner</small>
        <i aria-hidden="true">↗</i>
      </button>
      <button
        class="proof-tab"
        type="button"
        role="tab"
        data-graph-node="learning"
        aria-selected="false"
        aria-controls="capability-evidence"
      >
        <span>Learning systems</span>
        <strong>Mathematical foundations and continued practice</strong>
        <small>Grounded in coursework and algorithm practice</small>
        <i aria-hidden="true">↗</i>
      </button>
      <button
        class="proof-tab"
        type="button"
        role="tab"
        data-graph-node="product"
        aria-selected="false"
        aria-controls="capability-evidence"
      >
        <span>Product systems</span>
        <strong>Complex flows made understandable</strong>
        <small>Demonstrated in Nexora IMS</small>
        <i aria-hidden="true">↗</i>
      </button>
      <button
        class="proof-tab"
        type="button"
        role="tab"
        data-graph-node="shipping"
        aria-selected="false"
        aria-controls="capability-evidence"
      >
        <span>Production engineering</span>
        <strong>Applications carried into real environments</strong>
        <small>Demonstrated in Nexora IMS</small>
        <i aria-hidden="true">↗</i>
      </button>
    </div>
  </div>

  <div class="proof-graph__readout" id="capability-evidence" role="tabpanel" tabindex="0">
    <div class="proof-graph__evidence-head">
      <span class="signal"><i></i> Evidence from active work</span>
      <span class="mono" data-graph-project>MM2 Pattern Miner</span>
    </div>
    <div class="proof-graph__statement">
      <p class="eyebrow" data-graph-signal>Represent → connect → infer</p>
      <h3 id="graph-title" data-graph-title>Reasoning systems</h3>
      <p data-graph-copy>
        Pattern mining inside Hyperon connects symbolic representation, conjunction expansion,
        support filtering, and surprisingness scoring.
      </p>
    </div>
    <div class="proof-graph__methods" data-graph-methods>
      <span>Support filtering</span><span>Conjunction expansion</span><span
        >Surprisingness scoring</span
      >
    </div>
    <a class="text-link" href="#capabilities" data-graph-link
      >See the complete capability map <span aria-hidden="true">↓</span></a
    >
  </div>
</section>

<script>
  const graphData = {
    reasoning: {
      project: "MM2 Pattern Miner",
      signal: "Represent → connect → infer",
      title: "Reasoning systems",
      copy: "Pattern mining inside Hyperon connects symbolic representation, conjunction expansion, support filtering, and surprisingness scoring.",
      methods: ["Support filtering", "Conjunction expansion", "Surprisingness scoring"],
    },
    learning: {
      project: "Coursework · Algorithm practice",
      signal: "Derive → implement → evaluate",
      title: "Learning systems",
      copy: "Mathematics and machine-learning coursework connect to regular algorithm practice, model evaluation, and continued study.",
      methods: ["Mathematical foundations", "Algorithm practice", "Model evaluation"],
    },
    product: {
      project: "Nexora IMS",
      signal: "Shape → build → iterate",
      title: "Product systems",
      copy: "Interfaces, permissions, data, and consequential user flows become coherent products instead of disconnected features.",
      methods: ["Role-aware workflows", "Product architecture", "Interface design"],
    },
    shipping: {
      project: "Nexora IMS",
      signal: "Package → deploy → observe",
      title: "Production engineering",
      copy: "Containers, databases, web servers, routing, and network constraints are treated as part of the product experience.",
      methods: ["Docker delivery", "PostgreSQL deployment", "VPS and LiteSpeed"],
    },
  } as const;

  const initProofGraph = () => {
    const graph = document.querySelector<HTMLElement>("[data-proof-graph]");
    if (!graph || graph.dataset.ready === "true") return;
    graph.dataset.ready = "true";

    const nodes = graph.querySelectorAll<HTMLButtonElement>("[data-graph-node]");
    const project = graph.querySelector<HTMLElement>("[data-graph-project]");
    const signal = graph.querySelector<HTMLElement>("[data-graph-signal]");
    const title = graph.querySelector<HTMLElement>("[data-graph-title]");
    const copy = graph.querySelector<HTMLElement>("[data-graph-copy]");
    const methods = graph.querySelector<HTMLElement>("[data-graph-methods]");

    nodes.forEach((node) => {
      node.addEventListener("click", () => {
        const key = node.dataset.graphNode as keyof typeof graphData;
        const data = graphData[key];
        nodes.forEach((item) => item.setAttribute("aria-selected", String(item === node)));
        if (project) project.textContent = data.project;
        if (signal) signal.textContent = data.signal;
        if (title) title.textContent = data.title;
        if (copy) copy.textContent = data.copy;
        if (methods) {
          methods.replaceChildren(
            ...data.methods.map((method) => {
              const item = document.createElement("span");
              item.textContent = method;
              return item;
            }),
          );
        }
      });
    });
  };

  document.addEventListener("astro:page-load", initProofGraph);
  initProofGraph();
</script>
