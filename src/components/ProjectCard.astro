---
import type { Project } from "@/data/projects";
import { withBase } from "@/utils/paths";
import ProjectVisual from "@/components/ProjectVisual.astro";
import StatusBadge from "@/components/StatusBadge.astro";

interface Props {
  project: Project;
  layout?: "feature" | "grid";
}

const { project, layout = "grid" } = Astro.props;
---

<article
  class:list={["project-card", `project-card--${layout}`, `accent--${project.accent}`]}
  data-project-card
  data-status={project.status}
  data-reveal
>
  <a
    class="project-card__visual"
    href={withBase(`work/${project.slug}/`)}
    tabindex="-1"
    aria-hidden="true"
  >
    <ProjectVisual type={project.visual} compact={layout === "grid"} />
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="mono">Selected project</span>
      <StatusBadge status={project.status} label={project.statusLabel} />
    </div>
    <p class="eyebrow">{project.eyebrow}</p>
    <h3><a href={withBase(`work/${project.slug}/`)}>{project.title}</a></h3>
    <p class="project-card__statement">{project.statement}</p>
    <p class="project-card__summary">{project.summary}</p>
    <ul class="tag-list" aria-label="Technologies and disciplines">
      {project.disciplines.slice(0, 5).map((discipline) => <li>{discipline}</li>)}
    </ul>
    <a class="text-link" href={withBase(`work/${project.slug}/`)}>
      Explore the system <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
