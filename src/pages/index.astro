---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProofGraph from "@/components/ProofGraph.astro";
import ContactSection from "@/components/ContactSection.astro";
import AlgorithmProfile from "@/components/AlgorithmProfile.astro";
import CredentialViewer from "@/components/CredentialViewer.astro";
import { projects } from "@/data/projects";
import { capabilityClusters, experience, learning, profile } from "@/data/profile";
import { credentials } from "@/data/credentials";
import { withBase } from "@/utils/paths";

const featuredProjects = projects.slice(0, 3);
const sections = [
  { id: "top", index: "00", label: "Intro" },
  { id: "selected-work", index: "01", label: "Work" },
  { id: "capabilities", index: "02", label: "Systems" },
  { id: "experience", index: "03", label: "Trajectory" },
  { id: "learning", index: "04", label: "Learning" },
  { id: "algorithmic-proof", index: "05", label: "Proof" },
  { id: "credentials", index: "06", label: "Credentials" },
  { id: "operating-manual", index: "07", label: "About" },
  { id: "contact", index: "08", label: "Contact" },
];
---

<BaseLayout sections={sections}>
  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-grid shell">
        <div class="hero-copy" data-reveal data-visible="true">
          <div class="hero-overline">
            <span class="signal-dot"></span>
            <span>AI engineer · Software builder</span>
            <span class="hero-overline__location">Addis Ababa / ET</span>
          </div>
          <h1 id="hero-title">
            I build intelligent systems from <em>first principles</em>—and ship them into the real
            world.
          </h1>
          <p class="hero-lede">{profile.support}</p>
          <div class="hero-actions">
            <a class="button" href="#selected-work">
              <span>Explore selected work</span><span aria-hidden="true">↓</span>
            </a>
            <a class="button button--ghost" href={`mailto:${profile.email}`}>
              <span>Start a conversation</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero-system" data-reveal data-visible="true" aria-label="Current system focus">
          <div class="hero-system__header">
            <span>WHAT I'M BUILDING</span>
            <span><i></i> ACTIVE PRACTICE</span>
          </div>
          <div class="hero-system__body">
            <article class="workbench-card workbench-card--primary">
              <div class="workbench-card__meta">
                <span>Nexora IMS</span><span class="workbench-state workbench-state--shipped"
                  >Shipped</span
                >
              </div>
              <h2>School operations, carried through deployment.</h2>
              <p>Role-aware administration, PostgreSQL, SMS, Docker, and live hosting.</p>
              <div class="workbench-stack" aria-label="Nexora IMS technologies">
                <span>PostgreSQL</span><span>Docker</span><span>LiteSpeed</span>
              </div>
            </article>
            <article class="workbench-card">
              <div class="workbench-card__meta">
                <span>MM2 Pattern Miner</span><span class="workbench-state">In progress</span>
              </div>
              <h2>Find symbolic patterns worth noticing.</h2>
              <p class="workbench-sequence">support → expand → score</p>
            </article>
            <article class="workbench-card">
              <div class="workbench-card__meta">
                <span>Berhan</span><span class="workbench-state workbench-state--amber"
                  >In progress</span
                >
              </div>
              <h2>Calmer donation journeys across distance.</h2>
              <p>Local and diaspora giving · recurring support · donor privacy</p>
            </article>
          </div>
          <div class="hero-system__footer">
            <span>Symbolic AI</span><span>Product systems</span><span>Production engineering</span>
          </div>
        </div>
      </div>

      <div class="hero-marquee" aria-hidden="true">
        <div>
          <span>SYMBOLIC AI</span><i></i><span>MACHINE LEARNING</span><i></i><span
            >PRODUCT SYSTEMS</span
          ><i></i><span>TECHNICAL TEACHING</span><i></i><span>PRODUCTION ENGINEERING</span><i></i>
          <span>SYMBOLIC AI</span><i></i><span>MACHINE LEARNING</span><i></i><span
            >PRODUCT SYSTEMS</span
          ><i></i><span>TECHNICAL TEACHING</span><i></i><span>PRODUCTION ENGINEERING</span><i></i>
        </div>
      </div>
      <a class="hero-scroll-cue" href="#selected-work">
        <span>Scroll to inspect</span><i aria-hidden="true"></i>
      </a>
    </section>

    <section class="proof-strip" aria-label="Current roles and focus">
      <div class="shell proof-strip__grid">
        <div>
          <p>Co-founder & Deputy Manager</p>
          <strong>Nexora Technology PLC</strong>
        </div>
        <div>
          <p>Programmer · Trainer · Evaluator</p>
          <strong>iCog Labs</strong>
        </div>
        <div>
          <p>Research direction</p>
          <strong>Symbolic + learning systems</strong>
        </div>
        <div>
          <p>Operating from</p>
          <strong>Addis Ababa, Ethiopia</strong>
        </div>
      </div>
    </section>

    <section class="section work-section" id="selected-work">
      <div class="shell">
        <SectionHeader
          index="01"
          eyebrow="Selected work"
          title="Systems with a reason to exist."
          description="Production software, symbolic intelligence, and product infrastructure—each shown with its status and the engineering decisions underneath."
        />
        <div class="featured-work">
          {featuredProjects.map((project) => <ProjectCard project={project} layout="feature" />)}
        </div>
        <div class="section-action" data-reveal>
          <p>Four active records in the workshop.</p>
          <a class="button button--ghost" href={withBase("work/")}
            >View all work <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="section capabilities-section" id="capabilities">
      <div class="shell">
        <SectionHeader
          index="02"
          eyebrow="Capabilities in practice"
          title="One practice. Four connected systems."
          description="I do not treat AI, product, and deployment as isolated skills. Each one changes the decisions made in the others."
        />
        <ProofGraph />
        <div class="capability-grid">
          {
            capabilityClusters.map((cluster) => (
              <article class="capability-card" data-reveal>
                <div class="capability-card__top">
                  <span>{cluster.signal}</span>
                  <span>Demonstrated practice</span>
                </div>
                <h3>{cluster.title}</h3>
                <p>{cluster.description}</p>
                <ul class="tag-list">
                  {cluster.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <div class="shell">
        <SectionHeader
          index="03"
          eyebrow="Experience"
          title="Building and teaching are part of the same loop."
          description="Shipping clarifies what matters. Teaching reveals whether the understanding is real."
        />
        <div class="timeline" data-reveal>
          {
            experience.map((item, index) => (
              <article class="timeline-item">
                <div class="timeline-marker">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <i aria-hidden="true" />
                </div>
                <div class="timeline-main">
                  <p class="eyebrow">{item.marker}</p>
                  <h3>{item.organization}</h3>
                </div>
                <div class="timeline-detail">
                  <strong>{item.role}</strong>
                  <p>{item.detail}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section learning-section" id="learning">
      <div class="shell learning-layout">
        <div class="learning-copy" data-reveal>
          <p class="section-kicker"><span>04</span><span>Learning system</span></p>
          <h2>The edge keeps moving. So does the work.</h2>
          <p>
            I prefer to understand an algorithm below its abstraction, test it against evidence, and
            only then reach for the framework.
          </p>
          <a class="text-link" href={withBase("work/ml-engineering-dojo/")}
            >Enter the ML Dojo <span aria-hidden="true">↗</span></a
          >
        </div>
        <div class="learning-board" data-reveal>
          <div class="learning-board__column">
            <div class="learning-board__header">
              <span class="status-dot status-dot--done"></span><span>Studied foundations</span
              ><strong>{learning.completed.length}</strong>
            </div>
            <ol>
              {
                learning.completed.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {item}
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="learning-board__column learning-board__column--active">
            <div class="learning-board__header">
              <span class="status-dot"></span><span>Current frontier</span><strong
                >{learning.current.length}</strong
              >
            </div>
            <ol>
              {
                learning.current.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {item}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <AlgorithmProfile />

    <section class="section credentials-preview" id="credentials">
      <div class="shell">
        <SectionHeader
          index="06"
          eyebrow="Credentials"
          title="Formal checkpoints along a self-directed path."
          description="Mathematics, machine learning, deep learning, NLP, and AI-assisted software engineering."
        />
        <div class="credential-rail" data-reveal>
          {
            credentials.slice(0, 6).map((credential, index) => (
              <a
                href={credential.href}
                target="_blank"
                rel="noreferrer"
                class="credential-card"
                data-credential-open={index}
                aria-label={`Preview ${credential.title}`}
              >
                <div>
                  <>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <span>{credential.category}</span>
                  </>
                </div>
                <h3>{credential.title}</h3>
                <p>
                  {credential.provider}
                  <span aria-hidden="true">↗</span>
                </p>
              </a>
            ))
          }
        </div>
        <div class="section-action" data-reveal>
          <p>9 supplied certificates across 3 learning tracks.</p>
          <a class="button button--ghost" href={withBase("credentials/")}
            >Browse credentials <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="about-bridge" id="operating-manual">
      <div class="shell about-bridge__grid" data-reveal>
        <figure
          class="about-bridge__portrait"
          style={`--portrait-image: url(${withBase("images/yonas-portrait.jpg")})`}
        >
          <img
            src={withBase("images/yonas-portrait.jpg")}
            alt="Portrait of Yonas"
            width="900"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <figcaption><strong>Yonas</strong><span>Addis Ababa, Ethiopia</span></figcaption>
        </figure>
        <div class="about-bridge__copy">
          <p class="eyebrow">Based in Addis Ababa · Building beyond boundaries</p>
          <h2>First principles are not an aesthetic. They are how I get unstuck.</h2>
          <p>
            I move between code, mathematical reasoning, technical training, and production
            operations. The common thread is a need to understand the system well enough to improve
            it—and explain it clearly enough for others to build on.
          </p>
          <a class="text-link" href={withBase("about/")}
            >More about how I work <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <ContactSection />
    <CredentialViewer />
  </main>
</BaseLayout>
