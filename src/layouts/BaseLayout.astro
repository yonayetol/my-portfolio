---
import "@fontsource-variable/space-grotesk";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";

import "@/styles/global.css";
import "@/styles/home.css";
import Header from "@/components/global/Header.astro";
import Footer from "@/components/global/Footer.astro";

import { profile, socialLinks } from "@/data/profile";
import { withBase } from "@/utils/paths";

interface Props {
  immersive?: boolean;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalPath?: string;
  sections?: Array<{ id: string; index: string; label: string }>;
}

const {
  immersive = false,
  title = `${profile.name} — ${profile.role}`,
  description = profile.support,
  image = withBase("social-card.png"),
  noindex = false,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image.replace(/^\//, ""), Astro.site ?? Astro.url.origin);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.role,
    email: `mailto:${profile.email}`,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Addis Ababa",
      addressCountry: "ET",
    },
    sameAs: socialLinks.slice(0, 2).map((link) => link.href),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#182823" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        document.documentElement.dataset.js = "true";
        let evening = true,
          motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;
        try {
          evening = localStorage.getItem("home-evening-v2") !== "false";
          motion = motion && localStorage.getItem("home-motion") !== "off";
        } catch {}
        document.documentElement.dataset.theme = evening ? "dark" : "light";
        document.documentElement.dataset.motion = motion ? "on" : "off";
        document.documentElement.style.colorScheme = evening ? "dark" : "light";
      })();
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <noscript
      ><style is:global>
        [data-map-open],
        [data-evening],
        [data-motion-toggle],
        [data-copy-email],
        .garden-topics {
          display: none !important;
        }
        [data-garden-panel][hidden] {
          display: block !important;
        }
      </style></noscript
    >
    {!immersive && <Header />}
    <slot />
    {!immersive && <Footer />}
    <script>
      import { initHome } from "@/components/home/home";
      initHome();
    </script>
  </body>
</html>
