---
import type { ProjectVisual as VisualType } from "@/data/projects";
import { withBase } from "@/utils/paths";

interface Props {
  type: VisualType;
  compact?: boolean;
}

const { type, compact = false } = Astro.props;
---

<div
  class:list={["project-visual", `project-visual--${type}`, { "project-visual--compact": compact }]}
  aria-hidden="true"
>
  <div class="visual-grid"></div>

  {
    type === "infrastructure" && (
      <div class="ims-evidence">
        <img
          src={withBase("images/projects/nexora-ims-school-life.webp")}
          alt=""
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
        <div class="ims-evidence__topline">
          <span>
            <i /> PROJECT SCREENSHOT
          </span>
          <span>ABDI ADAMA SCHOOL / SCHOOL LIFE</span>
        </div>
        <div class="ims-evidence__readout">
          <span>PUBLIC INTERFACE</span>
          <strong>From system architecture to the screen people use.</strong>
          <small>ROLES → DATA → NOTIFICATIONS → DEPLOYMENT</small>
        </div>
        <span class="ims-evidence__index">DEPLOYED SCHOOL IMS</span>
      </div>
    )
  }

  {
    type === "pattern" && (
      <div class="pattern-map">
        <svg viewBox="0 0 600 360" role="presentation">
          <g class="pattern-lines">
            <path d="M76 186 181 86 291 173 394 76 512 165" />
            <path d="M76 186 190 276 291 173 401 282 512 165" />
            <path d="M181 86 190 276M394 76 401 282" />
          </g>
          <g class="pattern-nodes">
            <circle cx="76" cy="186" r="14" />
            <circle cx="181" cy="86" r="10" />
            <circle cx="190" cy="276" r="10" />
            <circle class="pattern-core" cx="291" cy="173" r="23" />
            <circle cx="394" cy="76" r="10" />
            <circle cx="401" cy="282" r="10" />
            <circle cx="512" cy="165" r="14" />
          </g>
        </svg>
        <span class="pattern-code pattern-code--a">min_support(p) ≥ τ</span>
        <span class="pattern-code pattern-code--b">expand ∧ score</span>
        <span class="visual-label">HYPERGRAPH PATTERN SEARCH</span>
      </div>
    )
  }

  {
    (type === "management" || type === "examination") && (
      <div class:list={["systems-exhibit", `systems-exhibit--${type}`]}>
        <span class="systems-exhibit__eyebrow">
          {type === "management" ? "ACADEMIC WORKFLOWS" : "PREPARE · DELIVER · UNDERSTAND"}
        </span>
        <svg viewBox="0 0 600 320" role="presentation">
          {type === "management" ? (
            <>
              <rect
                x="175"
                y="65"
                width="250"
                height="190"
                rx="10"
                fill="#fff9ec"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M175 107h250M235 108v147"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle cx="194" cy="86" r="3" fill="currentColor" />
              <circle cx="207" cy="86" r="3" fill="currentColor" />
              <path
                d="M253 133h150M253 157h150M253 181h150M253 205h150M280 133v72M341 133v72"
                fill="none"
                stroke="currentColor"
                stroke-opacity=".4"
              />
              <rect x="192" y="126" width="24" height="8" rx="2" fill="currentColor" opacity=".6" />
              <rect x="192" y="148" width="24" height="8" rx="2" fill="currentColor" opacity=".3" />
              <rect x="192" y="170" width="24" height="8" rx="2" fill="currentColor" opacity=".3" />
              <path
                d="M175 160H105m320 0h70"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-dasharray="4 5"
              />
              <circle
                cx="80"
                cy="160"
                r="25"
                fill="#fff9ec"
                stroke="currentColor"
                stroke-width="2"
              />
              <circle
                cx="520"
                cy="160"
                r="25"
                fill="#fff9ec"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="m67 160 9 9 17-19M510 151h20v19h-20z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
            </>
          ) : (
            <>
              <rect
                x="80"
                y="70"
                width="145"
                height="190"
                rx="8"
                fill="#fff9ec"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M105 105h75M105 135h94M105 155h94M105 185h94M105 205h94"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              />
              <path
                d="m108 234 9 8 17-18M247 165h68m-12-10 12 10-12 10"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
              <rect
                x="337"
                y="85"
                width="185"
                height="160"
                rx="8"
                fill="#fff9ec"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M357 213h145M357 112v101"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
              <rect x="376" y="167" width="24" height="46" fill="currentColor" opacity=".4" />
              <rect x="416" y="143" width="24" height="70" fill="currentColor" opacity=".65" />
              <rect x="456" y="119" width="24" height="94" fill="currentColor" />
            </>
          )}
        </svg>
        <span class="systems-exhibit__caption">
          {type === "management"
            ? "Public information, learning materials, academic work."
            : "An examination is a process. The results are a starting point."}
        </span>
        <small>ILLUSTRATIVE SYSTEM STUDY · IN PROGRESS</small>
      </div>
    )
  }
</div>

<style>
  .systems-exhibit {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px;
    background: #e5eadc;
    color: #48644b;
  }
  .systems-exhibit--examination {
    background: #f0e6d4;
    color: #88613f;
  }
  .systems-exhibit svg {
    width: min(700px, 95%);
    height: auto;
    max-height: 65%;
  }
  .systems-exhibit__eyebrow,
  .systems-exhibit small {
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    letter-spacing: 1px;
    text-align: center;
  }
  .systems-exhibit__caption {
    font:
      italic 19px/1.4 Georgia,
      serif;
    text-align: center;
    margin: 5px 0 18px;
    max-width: 500px;
  }
  @media (max-width: 640px) {
    .systems-exhibit {
      padding: 20px;
    }
    .systems-exhibit__eyebrow,
    .systems-exhibit small {
      font-size: 7px;
    }
    .systems-exhibit__caption {
      font-size: 15px;
      margin-bottom: 12px;
    }
  }
</style>
