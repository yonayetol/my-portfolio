<div class="chapter-flash" data-chapter-flash aria-hidden="true">
  <span class="chapter-flash__wipe" data-chapter-wipe></span>
  <span class="chapter-flash__index" data-chapter-index>00</span>
  <span class="chapter-flash__label" data-chapter-label>INTRO</span>
  <span class="chapter-flash__rule"></span>
</div>

<script>
  const initScrollChoreography = () => {
    const stage = document.querySelector<HTMLElement>("[data-chapter-flash]");
    if (!stage || stage.dataset.ready === "true") return;
    stage.dataset.ready = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reducedMotion.matches) return;

    const chapters = [
      { selector: ".hero", index: "00", label: "INTRO" },
      { selector: ".work-section", index: "01", label: "SELECTED WORK" },
      { selector: ".capabilities-section", index: "02", label: "SYSTEMS" },
      { selector: ".experience-section", index: "03", label: "TRAJECTORY" },
      { selector: ".learning-section", index: "04", label: "LEARNING" },
      { selector: ".algorithm-section", index: "05", label: "ALGORITHMIC PROOF" },
      { selector: ".credentials-preview", index: "06", label: "CREDENTIALS" },
      { selector: ".about-bridge", index: "07", label: "OPERATING MANUAL" },
      { selector: ".contact-section", index: "08", label: "OPEN CHANNEL" },
    ].map((chapter) => ({ ...chapter, element: document.querySelector(chapter.selector) }));

    const indexNode = stage.querySelector<HTMLElement>("[data-chapter-index]");
    const labelNode = stage.querySelector<HTMLElement>("[data-chapter-label]");
    const wipeNode = stage.querySelector<HTMLElement>("[data-chapter-wipe]");
    let activeLabel = "";
    let hasInitialChapter = false;

    const activateChapter = (chapter: (typeof chapters)[number]) => {
      if (chapter.label === activeLabel) return;
      activeLabel = chapter.label;
      if (indexNode) indexNode.textContent = chapter.index;
      if (labelNode) labelNode.textContent = chapter.label;

      if (!hasInitialChapter) {
        hasInitialChapter = true;
        return;
      }

      stage.getAnimations().forEach((animation) => animation.cancel());
      indexNode?.getAnimations().forEach((animation) => animation.cancel());
      labelNode?.getAnimations().forEach((animation) => animation.cancel());
      wipeNode?.getAnimations().forEach((animation) => animation.cancel());

      stage.animate(
        [
          { opacity: 0, transform: "translate3d(0, 16vh, 0) scale(.94)" },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.2 },
          { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.58 },
          { opacity: 0, transform: "translate3d(0, -13vh, 0) scale(1.045)" },
        ],
        { duration: 1350, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );

      indexNode?.animate(
        [
          { transform: "translate3d(-8vw, 0, 0) rotate(-5deg)" },
          { transform: "translate3d(0, 0, 0) rotate(0deg)", offset: 0.4 },
          { transform: "translate3d(6vw, -2vh, 0) rotate(3deg)" },
        ],
        { duration: 1350, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );

      labelNode?.animate(
        [
          { letterSpacing: "-.06em", transform: "translate3d(5vw, 0, 0)" },
          { letterSpacing: ".01em", transform: "translate3d(0, 0, 0)", offset: 0.45 },
          { letterSpacing: ".08em", transform: "translate3d(-3vw, 0, 0)" },
        ],
        { duration: 1350, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );

      wipeNode?.animate(
        [
          { transform: "scaleX(0)", transformOrigin: "left" },
          { transform: "scaleX(1)", transformOrigin: "left", offset: 0.34 },
          { transform: "scaleX(1)", transformOrigin: "right", offset: 0.56 },
          { transform: "scaleX(0)", transformOrigin: "right" },
        ],
        { duration: 1050, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );
    };

    const chapterObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        const chapter = chapters.find((item) => item.element === visible.target);
        if (chapter) activateChapter(chapter);
      },
      { rootMargin: "-44% 0px -44%", threshold: 0 },
    );

    const scenes = [
      ...document.querySelectorAll<HTMLElement>("main > section"),
      ...document.querySelectorAll<HTMLElement>(".project-card--feature"),
    ];

    let animationFrame = 0;
    let effectsActive = false;

    const activateEffects = () => {
      if (effectsActive) return;
      effectsActive = true;
      document.documentElement.dataset.scrollFx = "true";
      scenes.forEach((scene) => scene.setAttribute("data-scroll-scene", ""));
      chapters.forEach((chapter) => {
        if (chapter.element) chapterObserver.observe(chapter.element);
      });
    };

    const renderScenes = () => {
      animationFrame = 0;
      const viewportHeight = window.innerHeight;
      const strength = window.innerWidth <= 800 ? 0.52 : 1;
      const visibleScenes = scenes
        .map((scene) => ({ scene, rect: scene.getBoundingClientRect() }))
        .filter(
          ({ rect }) => rect.bottom >= -viewportHeight * 0.25 && rect.top <= viewportHeight * 1.25,
        );

      visibleScenes.forEach(({ scene, rect }) => {
        const progress = Math.max(
          0,
          Math.min(1, (viewportHeight - rect.top) / (viewportHeight + rect.height)),
        );
        const delta = progress - 0.5;
        const scale = 1.025 + (0.5 - Math.abs(delta)) * 0.025;
        const heroOpacity = Math.max(0.34, 1 - Math.max(0, progress - 0.58) * 1.9);

        scene.style.setProperty("--scene-y", `${delta * -104 * strength}px`);
        scene.style.setProperty("--scene-y-soft", `${delta * -62 * strength}px`);
        scene.style.setProperty("--scene-y-opposite", `${delta * 62 * strength}px`);
        scene.style.setProperty("--scene-heading-x", `${delta * -84 * strength}px`);
        scene.style.setProperty("--scene-media-y", `${delta * -46 * strength}px`);
        scene.style.setProperty("--scene-tilt", `${delta * -2.4 * strength}deg`);
        scene.style.setProperty("--scene-scale", String(scale));
        scene.style.setProperty("--scene-opacity", String(heroOpacity));
      });
    };

    const scheduleRender = () => {
      if (animationFrame) return;
      animationFrame = window.requestAnimationFrame(renderScenes);
    };

    const handleScroll = () => {
      activateEffects();
      scheduleRender();
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    window.addEventListener("resize", () => {
      if (effectsActive) scheduleRender();
    });
  };

  document.addEventListener("astro:page-load", initScrollChoreography);
  initScrollChoreography();
</script>
