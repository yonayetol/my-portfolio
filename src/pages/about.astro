---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { capabilityClusters, experience, profile } from "@/data/profile";
import { withBase } from "@/utils/paths";
import "@/styles/interiors.css";
const principles = [
  {
    title: "Start beneath the surface.",
    text: "Understand what an abstraction hides. Derive the idea, rebuild the mechanism, and make the framework a deliberate choice.",
  },
  {
    title: "Let the evidence speak.",
    text: "Inspect intermediate states, test assumptions, and make the behavior visible before reaching for an explanation.",
  },
  {
    title: "Carry it into the world.",
    text: "A useful system includes its deployment. The database, network, server, and people using it are all part of the work.",
  },
];
---

<BaseLayout
  title="The main room · About Yonas"
  description="Meet Yonas, an AI engineer, software builder, technical trainer, and fourth-year Computer Science student at Addis Ababa University (AAU)."
>
  <main id="main-content" class="interior-page">
    <header class="home-shell interior-heading interior-about-heading" id="top">
      <a class="interior-breadcrumb" href={withBase()}>← Back to the courtyard</a>
      <div class="interior-about-grid">
        <div>
          <p class="home-eyebrow">Room 01 / The main room</p><h1>
            A curious mind.<br />An open <em>door.</em>
          </h1><p class="interior-deck">
            I’m Yonas. I like understanding how things work—and making them work better.
          </p><p>
            AI engineer, software builder, and technical trainer.<br />At home in Addis Ababa,
            Ethiopia.
          </p><p>{profile.education}</p><a class="home-link" href={`mailto:${profile.email}`}
            >Say hello ↗</a
          >
        </div><figure class="interior-portrait">
          <img
            src={withBase("images/yonas-portrait.jpg")}
            alt="Yonas"
            width="900"
            height="1200"
            fetchpriority="high"
          /><figcaption><span>THE PERSON BEHIND THE WORK</span><strong>Yonas</strong></figcaption>
        </figure>
      </div>
    </header>
    <section class="home-shell interior-case-section" id="practice">
      <p class="home-eyebrow">Pull up a chair</p><div>
        <h2>Reasoning, building,<br /><em>and passing it on.</em></h2><p class="interior-lead">
          My work sits where symbolic reasoning, machine learning, and real product infrastructure
          meet.
        </p><p>
          Sometimes that means tracing a pattern through a hypergraph. Sometimes it means rebuilding
          a machine-learning algorithm from its mathematics. Sometimes it means debugging the
          hosting layer until a product actually reaches the people who need it.
        </p><p>
          Teaching belongs in that same loop. At iCog Labs, my work includes programming, technical
          training, intern mentorship, symbolic-AI learning material, and analytical assessment
          design. Explaining a system makes my understanding sharper—and makes it useful to someone
          else.
        </p>
      </div>
    </section>
    <section class="interior-decision-section" id="principles">
      <div class="home-shell">
        <div class="interior-section-heading">
          <p class="home-eyebrow">Notes I keep close</p><h2>A few things<br />I build by.</h2>
        </div><div class="interior-decisions">
          {
            principles.map((item, i) => (
              <article>
                <>
                  <span class="interior-decision-number">0{i + 1}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="home-shell interior-experience" id="trajectory">
      <div class="interior-section-heading">
        <p class="home-eyebrow">The people and places</p><h2>
          Where the work<br /><em>takes me.</em>
        </h2>
      </div>{
        experience.map((item, i) => (
          <article class="interior-experience-row">
            <>
              <span class="interior-small">0{i + 1}</span>
              <div>
                <>
                  <h3>{item.organization}</h3>
                  <span>{item.role}</span>
                </>
              </div>
              <p>{item.detail}</p>
            </>
          </article>
        ))
      }
    </section>
    <section class="home-shell interior-toolkit" id="technical-map">
      <div class="interior-section-heading">
        <p class="home-eyebrow">Tools on the shelf</p><h2>
          Different tools.<br />Connected thinking.
        </h2>
      </div><div class="interior-toolkit-grid">
        {
          capabilityClusters.map((cluster) => (
            <article>
              <>
                <span class="interior-small">{cluster.signal}</span>
                <h3>{cluster.title}</h3>
                <p>{cluster.description}</p>
                <ul class="interior-tags">
                  {cluster.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <aside class="home-shell interior-endnote">
      <span class="home-eyebrow">Always a little more to learn</span><p>
        The garden is still growing. I’m moving from classical machine-learning foundations into
        deep learning, transformers, agents, and distributed AI.
      </p><a class="home-link" href={`${withBase()}#garden`}>Take a walk through the garden →</a>
    </aside>
  </main>
</BaseLayout>
