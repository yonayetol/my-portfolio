---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CredentialViewer from "@/components/CredentialViewer.astro";
import { credentialCategories, credentials } from "@/data/credentials";
import { codingProfile } from "@/data/profile";
import { withBase } from "@/utils/paths";
import "@/styles/interiors.css";
---

<BaseLayout
  title="The reading nook · Credentials by Yonas"
  description="A shelf of learning records in mathematics, machine learning, deep learning, NLP, and applied AI."
>
  <main id="main-content" class="interior-page">
    <header class="home-shell interior-heading" id="top">
      <a class="interior-breadcrumb" href={withBase()}>← Back to the courtyard</a><p
        class="home-eyebrow"
      >
        Room 05 / The reading nook
      </p><div class="interior-heading-row">
        <h1>Always a<br /><em>student.</em></h1><div>
          <p>
            A small shelf of formal checkpoints along a self-directed path. Mathematics, machine
            learning, and the ideas I keep coming back to.
          </p><span class="interior-small"
            >{credentials.length} RECORDS · {credentialCategories.length} LEARNING TRACKS</span
          >
        </div>
      </div>
    </header>
    <section class="home-shell interior-credentials" aria-label="Learning records">
      {
        credentialCategories.map((category, i) => (
          <section
            id={`credential-track-${i}`}
            class="interior-credential-group"
            aria-labelledby={`category-${i}`}
          >
            <>
              <header>
                <>
                  <span class="interior-book-spine" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <div>
                    <>
                      <p class="home-eyebrow">Shelf 0{i + 1}</p>
                      <h2 id={`category-${i}`}>{category}</h2>
                    </>
                  </div>
                  <span class="interior-small">
                    {credentials.filter((item) => item.category === category).length} RECORDS
                  </span>
                </>
              </header>
              <ol>
                {credentials
                  .filter((item) => item.category === category)
                  .map((credential) => (
                    <li>
                      <span class="interior-small">
                        {String(credentials.indexOf(credential) + 1).padStart(2, "0")}
                      </span>
                      <div>
                        <h3>{credential.title}</h3>
                        <span>{credential.provider}</span>
                      </div>
                      <a
                        href={credential.href}
                        target="_blank"
                        rel="noreferrer"
                        data-credential-open={credentials.indexOf(credential)}
                        aria-label={`Preview ${credential.title}`}
                      >
                        View record <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
              </ol>
            </>
          </section>
        ))
      }
    </section>
    <section class="interior-practice-note">
      <div class="home-shell interior-practice-grid">
        <div>
          <p class="home-eyebrow">A page from the practice notebook</p><h2>
            Small problems.<br /><em>Stronger foundations.</em>
          </h2><p>
            Algorithm practice is part of how I keep my reasoning sharp. These numbers are a dated
            snapshot of my LeetCode profile.
          </p><a class="home-link" href={codingProfile.href} target="_blank" rel="noreferrer"
            >Visit my LeetCode profile ↗</a
          >
        </div><div class="interior-stat-note">
          <span class="interior-small">LEETCODE / {codingProfile.capturedAt}</span><strong
            >{codingProfile.totalSolved}<span>problems solved</span></strong
          ><dl>
            {
              codingProfile.difficulty.map((item) => (
                <div>
                  <>
                    <dt>{item.label}</dt>
                    <dd>{item.solved}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>
    <aside class="home-shell interior-endnote">
      <span class="home-eyebrow">Keep following the thread</span><p>
        The certificates mark a checkpoint. The workshop shows how that learning turns into ideas,
        experiments, and useful systems.
      </p><a class="home-link" href={withBase("work/")}>Step into the workshop →</a>
    </aside>
    <CredentialViewer />
  </main>
</BaseLayout>
