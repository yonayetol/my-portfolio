---
import { codingProfile } from "@/data/profile";

const colors = ["#398875", "#b08236", "#ba6659"];
const ringParts = codingProfile.difficulty.map((item, index) => ({
  ...item,
  color: colors[index],
  offset: -(index * (100 / 3)),
  coverage: (item.solved / item.available) * 30.5,
  percent: (item.solved / item.available) * 100,
}));
---

<section class="coding-practice" aria-label="LeetCode practice snapshot">
  <div class="coding-practice__paper">
    <header class="coding-practice__header">
      <div>
        <span class="coding-practice__eyebrow">The practice notebook</span>
        <h3>One problem at a time.</h3>
      </div>
      <span class="coding-practice__bookmark" aria-hidden="true">
        <svg viewBox="0 0 24 30" fill="none"
          ><path d="M3 1h18v27l-9-6-9 6Z" fill="currentColor"></path><path
            d="m8 10 3 3 5-6"
            stroke="#fff9ef"
            stroke-width="1.5"></path></svg
        >
      </span>
    </header>

    <div class="coding-practice__body">
      <div class="coding-practice__ring">
        <svg
          viewBox="0 0 180 180"
          role="img"
          aria-label="Problem coverage by difficulty. Each colored segment shows solved problems as a share of the available problems in that difficulty."
        >
          <title>LeetCode problem coverage</title>
          {
            ringParts.map((item) => (
              <g transform="rotate(-90 90 90)">
                <circle
                  cx="90"
                  cy="90"
                  r="73"
                  pathLength="100"
                  fill="none"
                  stroke={item.color}
                  stroke-opacity=".16"
                  stroke-width="7"
                  stroke-linecap="round"
                  stroke-dasharray="30.5 69.5"
                  stroke-dashoffset={item.offset}
                />
                <circle
                  cx="90"
                  cy="90"
                  r="73"
                  pathLength="100"
                  fill="none"
                  stroke={item.color}
                  stroke-width="7"
                  stroke-linecap="round"
                  stroke-dasharray={`${item.coverage} ${100 - item.coverage}`}
                  stroke-dashoffset={item.offset}
                />
              </g>
            ))
          }
        </svg>
        <div class="coding-practice__total">
          <strong>{codingProfile.totalSolved}</strong>
          <span>problems solved</span>
          <small>of {codingProfile.totalAvailable.toLocaleString("en-US")}</small>
        </div>
      </div>

      <dl class="coding-practice__difficulty">
        {
          ringParts.map((item) => (
            <div
              style={`--difficulty-color: ${item.color}; --difficulty-progress: ${item.percent}%`}
            >
              <dt>
                <i aria-hidden="true" />
                {item.label}
              </dt>
              <dd>
                <strong>{item.solved}</strong>
                <span> / {item.available.toLocaleString("en-US")}</span>
              </dd>
              <span class="coding-practice__track" aria-hidden="true">
                <i />
              </span>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="coding-practice__attempts">
      <span><i aria-hidden="true"></i>Still working on it</span>
      <strong>{codingProfile.attempting} attempting</strong>
    </div>

    <footer class="coding-practice__footer">
      <div><span>LeetCode</span><small>{codingProfile.capturedAt}</small></div>
      <a
        href={codingProfile.href}
        target="_blank"
        rel="noreferrer"
        aria-label="Visit Yonas’s LeetCode profile (opens in a new tab)"
        >@{codingProfile.username} <span aria-hidden="true">↗</span></a
      >
    </footer>
    <p class="coding-practice__note">
      Totals reflect the shared screenshot. Denominators are the platform’s available problems, not
      skill scores.
    </p>
  </div>
</section>

<style>
  .coding-practice {
    container-type: inline-size;
    width: 100%;
    min-width: 0;
    color: var(--home-ink, #29362d);
  }

  .coding-practice__paper {
    position: relative;
    padding: 24px;
    background: var(--home-paper, #f6f2e9);
    border: 1px solid var(--home-line, #d9dacd);
    border-radius: 5px 18px 18px 5px;
    box-shadow:
      4px 4px 0 var(--home-paper, #f6f2e9),
      5px 5px 0 var(--home-line, #d9dacd);
  }

  .coding-practice__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .coding-practice__eyebrow {
    font: 9px/1.6 var(--font-mono, monospace);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--home-muted, #697166);
  }

  .coding-practice__header h3 {
    margin: 7px 0 0;
    font:
      26px/1.16 Georgia,
      serif;
    letter-spacing: -0.04em;
    color: inherit;
  }

  .coding-practice__bookmark {
    width: 21px;
    flex-shrink: 0;
    color: var(--home-green, #315343);
    margin-top: -25px;
  }

  .coding-practice__bookmark svg {
    width: 100%;
    height: auto;
  }

  .coding-practice__body {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .coding-practice__ring {
    position: relative;
    width: 170px;
    aspect-ratio: 1;
  }

  .coding-practice__ring > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .coding-practice__total {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }

  .coding-practice__total strong {
    font:
      44px/1.1 Georgia,
      serif;
    letter-spacing: -0.05em;
  }
  .coding-practice__total span {
    margin-top: 4px;
    font-size: 10px;
  }
  .coding-practice__total small {
    margin-top: 4px;
    color: var(--home-muted, #697166);
    font-size: 10px;
  }

  .coding-practice__difficulty {
    width: 100%;
    display: grid;
    gap: 15px;
    margin: 0;
  }
  .coding-practice__difficulty > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 7px;
    align-items: center;
  }
  .coding-practice__difficulty dt {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
  }
  .coding-practice__difficulty dt i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--difficulty-color);
  }
  .coding-practice__difficulty dd {
    margin: 0;
    white-space: nowrap;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }
  .coding-practice__difficulty dd strong {
    font-size: 13px;
    font-weight: 500;
  }
  .coding-practice__difficulty dd span {
    color: var(--home-muted, #697166);
  }
  .coding-practice__track {
    grid-column: 1 / -1;
    display: block;
    height: 3px;
    background: var(--home-line, #d9dacd);
    border-radius: 10px;
    overflow: hidden;
  }
  .coding-practice__track i {
    display: block;
    width: var(--difficulty-progress);
    height: 100%;
    background: var(--difficulty-color);
  }

  .coding-practice__attempts {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    margin-top: 23px;
    padding: 12px 0;
    border-top: 1px dashed var(--home-line, #d9dacd);
    border-bottom: 1px dashed var(--home-line, #d9dacd);
    font-size: 10px;
  }
  .coding-practice__attempts > span {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--home-muted, #697166);
  }
  .coding-practice__attempts i {
    display: block;
    width: 7px;
    height: 7px;
    border: 1px solid #b08236;
    border-radius: 50%;
  }
  .coding-practice__attempts strong {
    font-weight: 500;
    white-space: nowrap;
  }

  .coding-practice__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 17px;
    font-size: 11px;
  }
  .coding-practice__footer > div {
    display: grid;
    gap: 4px;
  }
  .coding-practice__footer small {
    font-size: 9px;
    color: var(--home-muted, #697166);
  }
  .coding-practice__footer a {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    color: var(--home-green, #315343);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .coding-practice__footer a:focus-visible {
    outline: 2px solid var(--home-blue, #3159be);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .coding-practice__note {
    margin: 12px 0 0;
    max-width: none;
    font-size: 9px;
    line-height: 1.7;
    color: var(--home-muted, #697166);
  }

  @container (min-width: 360px) {
    .coding-practice__body {
      grid-template-columns: 150px 1fr;
      align-items: center;
      gap: 20px;
    }
    .coding-practice__ring {
      width: 150px;
    }
    .coding-practice__total strong {
      font-size: 39px;
    }
  }

  @container (min-width: 500px) {
    .coding-practice__paper {
      padding: 32px;
    }
    .coding-practice__body {
      grid-template-columns: 180px 1fr;
      gap: 32px;
    }
    .coding-practice__ring {
      width: 180px;
    }
    .coding-practice__bookmark {
      margin-top: -33px;
    }
    .coding-practice__difficulty dt {
      font-size: 13px;
    }
    .coding-practice__difficulty dd {
      font-size: 12px;
    }
    .coding-practice__difficulty dd strong {
      font-size: 15px;
    }
    .coding-practice__total strong {
      font-size: 48px;
    }
  }
</style>
