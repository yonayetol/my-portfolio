---
import { profile } from "@/data/profile";
import { withBase } from "@/utils/paths";

const path = Astro.url.pathname;
const links = [
  { label: "Work", href: withBase("work/"), match: "/work" },
  { label: "About", href: withBase("about/"), match: "/about" },
  { label: "Credentials", href: withBase("credentials/"), match: "/credentials" },
];
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={withBase()}>
      <span class="brand-mark" aria-hidden="true">Y</span>
      <span class="brand-copy">
        <strong>{profile.name}</strong>
        <span>Intelligence workshop</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-nav-toggle
    >
      <span class="sr-only">Open navigation</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="site-navigation" class="site-nav" aria-label="Primary" data-nav>
      <div class="nav-links">
        {
          links.map((link) => (
            <a href={link.href} aria-current={path.includes(link.match) ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
        aria-pressed="false"
      >
        <span class="theme-toggle__icon" aria-hidden="true"><i></i></span>
        <span data-theme-label>Light</span>
        <span class="sr-only" data-theme-action>Switch to light theme</span>
      </button>
      <a class="button button--small" href={`${withBase()}#contact`} data-nav-contact>
        <span>Start a conversation</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const initNavigation = () => {
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const navigation = document.querySelector<HTMLElement>("[data-nav]");
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    if (!toggle || !navigation || toggle.dataset.ready === "true") return;

    toggle.dataset.ready = "true";

    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.querySelector(".sr-only")!.textContent = "Open navigation";
      navigation.removeAttribute("data-open");
      document.body.removeAttribute("data-nav-open");
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      toggle.querySelector(".sr-only")!.textContent = open ? "Open navigation" : "Close navigation";
      navigation.toggleAttribute("data-open", !open);
      document.body.toggleAttribute("data-nav-open", !open);
    });

    navigation.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        toggle.focus();
      }
    });
    window.matchMedia("(min-width: 801px)").addEventListener("change", close);

    const syncThemeControl = () => {
      if (!themeToggle) return;
      const light = document.documentElement.dataset.theme === "light";
      const actionText = light ? "Switch to dark theme" : "Switch to light theme";
      themeToggle.setAttribute("aria-pressed", String(light));
      themeToggle.setAttribute("aria-label", actionText);
      const label = themeToggle.querySelector<HTMLElement>("[data-theme-label]");
      const action = themeToggle.querySelector<HTMLElement>("[data-theme-action]");
      if (label) label.textContent = light ? "Dark" : "Light";
      if (action) action.textContent = actionText;
    };

    themeToggle?.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = nextTheme;
      document.documentElement.style.colorScheme = nextTheme;
      document
        .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
        ?.setAttribute("content", nextTheme === "light" ? "#f4f2ec" : "#080a0f");
      try {
        localStorage.setItem("portfolio-theme", nextTheme);
      } catch {
        // The selected theme still applies for the current page when storage is unavailable.
      }
      syncThemeControl();
    });

    syncThemeControl();
  };

  document.addEventListener("astro:page-load", initNavigation);
  initNavigation();
</script>
