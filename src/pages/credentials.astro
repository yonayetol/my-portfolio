---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import { credentialCategories, credentials } from "@/data/credentials";
---

<BaseLayout
  title="Credentials — Yonas"
  description="Verified-learning links across mathematics, machine learning, deep learning, NLP, and AI-assisted software engineering."
>
  <main id="main-content">
    <header class="page-hero credentials-hero" id="top">
      <div class="shell page-hero__grid">
        <div data-reveal data-visible="true">
          <p class="section-kicker"><span>03</span><span>Credentials / learning record</span></p>
          <h1>Checkpoints, not <em>finish lines.</em></h1>
        </div>
        <div class="page-hero__aside" data-reveal data-visible="true">
          <p>
            Nine supplied certificate records across the mathematical, machine-learning,
            deep-learning, NLP, and AI engineering path.
          </p>
          <span class="mono">09 credentials / 03 tracks</span>
        </div>
      </div>
    </header>

    <section class="credentials-ledger section">
      <div class="shell">
        <div class="ledger-head" data-reveal>
          <span>INDEX</span><span>LEARNING RECORD</span><span>PROVIDER</span><span>VERIFY</span>
        </div>
        {
          credentialCategories.map((category, categoryIndex) => (
            <section
              class="credential-group"
              aria-labelledby={`category-${categoryIndex}`}
              data-reveal
            >
              <header>
                <span>{String(categoryIndex + 1).padStart(2, "0")}</span>
                <h2 id={`category-${categoryIndex}`}>{category}</h2>
                <span>
                  {credentials.filter((item) => item.category === category).length} records
                </span>
              </header>
              <ol>
                {credentials
                  .filter((item) => item.category === category)
                  .map((credential) => {
                    const absoluteIndex = credentials.indexOf(credential) + 1;
                    return (
                      <li>
                        <span class="mono">{String(absoluteIndex).padStart(2, "0")}</span>
                        <h3>{credential.title}</h3>
                        <span>{credential.provider}</span>
                        <a
                          href={credential.href}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={`Open supplied verification link for ${credential.title}`}
                        >
                          Open record <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    );
                  })}
              </ol>
            </section>
          ))
        }
        <aside class="credential-disclosure" data-reveal>
          <span class="signal-dot"></span>
          <div>
            <strong>Transparent record</strong>
            <p>
              These external URLs were supplied with the portfolio data. Their titles are presented
              as provided and should receive a final logged-out browser check before public launch.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <ContactSection />
  </main>
</BaseLayout>
