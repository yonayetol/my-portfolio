<style>
  .room-illustration {
    width: 100%;
    isolation: isolate;
  }

  .room-illustration svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .room-steam {
    animation: room-steam-rise 6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .room-leaves {
    animation: room-leaf-sway 7s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  @keyframes room-steam-rise {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(2px) scaleX(0.9);
    }
    50% {
      opacity: 0.6;
      transform: translateY(-5px) scaleX(1.05);
    }
  }

  @keyframes room-leaf-sway {
    0%,
    100% {
      transform: rotate(-0.5deg);
    }
    50% {
      transform: rotate(0.75deg);
    }
  }

  :global(html[data-motion="off"]) .room-steam,
  :global(html[data-motion="off"]) .room-leaves,
  :global(html[data-page-hidden="true"]) .room-steam,
