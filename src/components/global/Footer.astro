---
import { socialLinks } from "@/data/profile";
import { withBase } from "@/utils/paths";
---

<footer class="home-footer home-shell">
  <div>
    <a class="footer-home-name" href={withBase()}>yonas.</a><p>
      Built with intention. Always growing.
    </p>
  </div>
  <nav aria-label="Social profiles">
    {
      socialLinks.slice(0, 2).map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label} ↗
        </a>
      ))
    }<a href={withBase("explore/")}>Explore in 3D ↗</a>
  </nav>
  <div class="home-footer-end">
    <span>© {new Date().getFullYear()} Yonas · Addis Ababa</span><button
      type="button"
      data-motion-toggle
      aria-pressed="false">Pause motion</button
    ><a href="#main-content">Back to top ↑</a>
  </div>
</footer>
