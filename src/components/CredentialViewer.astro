<div class="credential-viewer" data-credential-viewer>
  <dialog
    class="credential-window"
    data-credential-window
    aria-labelledby="credential-window-title"
    aria-describedby="credential-window-description"
  >
    <div class="credential-window__shell">
      <header class="credential-window__bar">
        <div class="credential-window__identity">
          <span class="credential-window__appmark" aria-hidden="true">Y</span>
          <div>
            <strong id="credential-window-title">Credential record</strong>
            <span>YONAS / READING NOOK</span>
          </div>
        </div>
        <div class="credential-window__controls" aria-label="Window controls">
          <button
            type="button"
            data-window-action="minimize"
            aria-label="Minimize credential window"
          >
            <span class="window-icon window-icon--minimize" aria-hidden="true"></span>
          </button>
          <button
            type="button"
            data-window-action="maximize"
            aria-label="Maximize credential window"
            aria-pressed="false"
          >
            <span class="window-icon window-icon--maximize" aria-hidden="true"></span>
          </button>
          <button type="button" data-window-action="close" aria-label="Close credential window">
            <span class="window-icon window-icon--close" aria-hidden="true"></span>
          </button>
        </div>
      </header>

      <div class="credential-window__body">
        <aside class="credential-window__rail" aria-label="Credential status">
          <div>
            <span>RECORD</span>
            <strong data-record-index>01 / 09</strong>
          </div>
          <div>
            <span>STATE</span>
            <strong><i></i> ON THE SHELF</strong>
          </div>
          <div>
            <span>CHANNEL</span>
            <strong>PROVIDER RECORD</strong>
          </div>
          <small>ALWAYS LEARNING<br />ALWAYS BUILDING</small>
        </aside>

        <article class="credential-document">
          <span class="credential-document__grid" aria-hidden="true"></span>
          <header>
            <span>LEARNING RECORD / <b data-record-category>FOUNDATIONS</b></span>
            <span data-record-reference>REF —</span>
          </header>

          <div class="credential-document__content">
            <p class="eyebrow">Presented to</p>
            <p class="credential-document__name">Yonas</p>
            <p id="credential-window-description">
              A checkpoint on my learning journey. Open the source below to view this record on the
              provider’s verification page.
            </p>
            <h2 data-record-title>Credential title</h2>

            <dl class="credential-document__meta">
              <div><dt>Provider</dt><dd data-record-provider>Coursera</dd></div>
              <div><dt>Track</dt><dd data-record-track>Foundations</dd></div>
              <div><dt>Record</dt><dd data-record-number>01 / 09</dd></div>
            </dl>
          </div>

          <div class="credential-document__seal" aria-hidden="true">
            <span>Y</span><i></i><small>LEARN<br />BUILD<br />ITERATE</small>
          </div>

          <footer>
            <span><i></i> SOURCE LINK ATTACHED</span>
            <a data-record-link href="#" target="_blank" rel="noreferrer">
              Verify with Coursera <span aria-hidden="true">↗</span>
            </a>
          </footer>
        </article>
      </div>
    </div>
  </dialog>

  <div class="credential-dock" data-credential-dock hidden>
    <button type="button" data-dock-action="restore">
      <span class="credential-window__appmark" aria-hidden="true">Y</span>
      <span><small>MINIMIZED RECORD</small><strong data-dock-title>Credential record</strong></span>
    </button>
    <button type="button" data-dock-action="close" aria-label="Close minimized credential window">
      <span class="window-icon window-icon--close" aria-hidden="true"></span>
    </button>
  </div>
</div>

<script>
  import { credentials } from "@/data/credentials";

  const initCredentialViewer = () => {
    const root = document.querySelector<HTMLElement>("[data-credential-viewer]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const dialog = root.querySelector<HTMLDialogElement>("[data-credential-window]");
    const dock = root.querySelector<HTMLElement>("[data-credential-dock]");
    const maximizeButton = root.querySelector<HTMLButtonElement>('[data-window-action="maximize"]');
    const recordLink = root.querySelector<HTMLAnchorElement>("[data-record-link]");
    const recordDocument = root.querySelector<HTMLElement>(".credential-document");
    if (!dialog || !dock || !maximizeButton || !recordLink || !recordDocument) return;

    let activeTrigger: HTMLElement | null = null;
    let minimized = false;

    const setText = (selector: string, value: string) => {
      root.querySelectorAll<HTMLElement>(selector).forEach((element) => {
        element.textContent = value;
      });
    };

    const referenceFrom = (href: string) => {
      try {
        return new URL(href).pathname.split("/").filter(Boolean).at(-1)?.toUpperCase() ?? "SOURCE";
      } catch {
        return "SOURCE";
      }
    };

    const populate = (index: number) => {
      const credential = credentials[index];
      if (!credential) return false;
      const recordNumber = `${String(index + 1).padStart(2, "0")} / ${String(credentials.length).padStart(2, "0")}`;

      setText("[data-record-index]", recordNumber);
      setText("[data-record-number]", recordNumber);
      setText("[data-record-title]", credential.title);
      setText("[data-record-provider]", credential.provider);
      setText("[data-record-track]", credential.category);
      setText("[data-record-category]", credential.category.toUpperCase());
      setText("[data-record-reference]", `REF ${referenceFrom(credential.href)}`);
      setText("[data-dock-title]", credential.title);
      recordDocument.dataset.titleDensity =
        credential.title.length > 70
          ? "compact"
          : credential.title.length > 52
            ? "condensed"
            : "standard";
      recordLink.href = credential.href;
      return true;
    };

    const setMaximized = (maximized: boolean) => {
      dialog.toggleAttribute("data-maximized", maximized);
      maximizeButton.setAttribute("aria-pressed", String(maximized));
      maximizeButton.setAttribute(
        "aria-label",
        maximized ? "Restore credential window size" : "Maximize credential window",
      );
    };

    const closeWindow = () => {
      minimized = false;
      dock.hidden = true;
      document.documentElement.classList.remove("credential-modal-open");
      setMaximized(false);
      if (dialog.open) dialog.close();
      else activeTrigger?.focus();
    };

    const minimizeWindow = () => {
      if (!dialog.open) return;
      minimized = true;
      document.documentElement.classList.remove("credential-modal-open");
      dialog.close();
      dock.hidden = false;
      window.requestAnimationFrame(() =>
        dock.querySelector<HTMLButtonElement>('[data-dock-action="restore"]')?.focus(),
      );
    };

    const restoreWindow = () => {
      minimized = false;
      dock.hidden = true;
      document.documentElement.classList.add("credential-modal-open");
      dialog.showModal();
    };

    document.addEventListener("click", (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>("[data-credential-open]");
      if (!trigger) return;
      const index = Number(trigger.dataset.credentialOpen);
      if (!Number.isInteger(index) || !populate(index)) return;

      event.preventDefault();
      activeTrigger = trigger;
      minimized = false;
      dock.hidden = true;
      document.documentElement.classList.add("credential-modal-open");
      setMaximized(false);
      if (!dialog.open) dialog.showModal();
    });

    root.addEventListener("click", (event) => {
      const control = (event.target as Element).closest<HTMLElement>("[data-window-action]");
      if (control?.dataset.windowAction === "minimize") minimizeWindow();
      if (control?.dataset.windowAction === "maximize") {
        setMaximized(!dialog.hasAttribute("data-maximized"));
      }
      if (control?.dataset.windowAction === "close") closeWindow();

      const dockControl = (event.target as Element).closest<HTMLElement>("[data-dock-action]");
      if (dockControl?.dataset.dockAction === "restore") restoreWindow();
      if (dockControl?.dataset.dockAction === "close") closeWindow();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeWindow();
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("credential-modal-open");
      if (!minimized) activeTrigger?.focus();
    });
  };

  document.addEventListener("astro:page-load", initCredentialViewer);
  initCredentialViewer();
</script>
