<div class="story-field" data-story-field aria-hidden="true">
  <span class="story-field__mesh"></span>
  <span class="story-field__orbit story-field__orbit--outer"></span>
  <span class="story-field__orbit story-field__orbit--inner"></span>
  <span class="story-field__thread"><i></i></span>
  <span class="story-field__signal"></span>
</div>

<script>
  const initScrollChoreography = () => {
    const field = document.querySelector<HTMLElement>("[data-story-field]");
    const railLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-scroll-target]")];
    if (!field || !railLinks.length || field.dataset.ready === "true") return;
    field.dataset.ready = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reducedMotion.matches) return;

    const chapters = railLinks
      .map((link, position) => ({
        element: document.getElementById(link.dataset.scrollTarget ?? ""),
        position,
      }))
      .filter((chapter): chapter is typeof chapter & { element: HTMLElement } =>
        Boolean(chapter.element),
      );

    let activeChapter = -1;
    const activateChapter = (position: number) => {
      if (position === activeChapter) return;
      activeChapter = position;
      field.dataset.chapter = String(position);
      document.documentElement.style.setProperty(
        "--chapter-progress",
        String(position / Math.max(chapters.length - 1, 1)),
      );
      field.animate(
        [
          { opacity: 0.2, filter: "saturate(.7)" },
          { opacity: 0.48, filter: "saturate(1.35)", offset: 0.42 },
          { opacity: 0.28, filter: "saturate(1)" },
        ],
        { duration: 720, easing: "cubic-bezier(.16, 1, .3, 1)" },
      );
    };

    const chapterObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        const chapter = visible && chapters.find((item) => item.element === visible.target);
        if (chapter) activateChapter(chapter.position);
      },
      { rootMargin: "-45% 0px -45%", threshold: 0 },
    );

    const sceneSelectors = [
      "main > header",
      "main > section",
      ".case-study > header",
      ".case-study > section",
      ".case-visual",
      ".project-card--feature",
      ".project-card--grid",
      ".decision-card",
      ".credential-group",
      ".principles-grid article",
      ".toolkit-table article",
    ];
    const scenes = [
      ...new Set(
        sceneSelectors.flatMap((selector) => [...document.querySelectorAll<HTMLElement>(selector)]),
      ),
    ];

    let animationFrame = 0;

    const renderScenes = () => {
      animationFrame = 0;
      const viewportHeight = window.innerHeight;
      const maxScroll = Math.max(document.documentElement.scrollHeight - viewportHeight, 1);
      const pageProgress = Math.max(0, Math.min(1, window.scrollY / maxScroll));
      const strength = window.innerWidth <= 800 ? 0.42 : 1;

      document.documentElement.style.setProperty("--story-progress", String(pageProgress));
      document.documentElement.style.setProperty(
        "--story-x",
        `${Math.sin(pageProgress * Math.PI * 2) * 7}vw`,
      );
      document.documentElement.style.setProperty("--story-y", `${(pageProgress - 0.5) * 18}vh`);
      document.documentElement.style.setProperty("--story-rotate", `${pageProgress * 150}deg`);
      document.documentElement.style.setProperty(
        "--story-scale",
        String(0.92 + pageProgress * 0.22),
      );
      document.documentElement.style.setProperty("--story-thread", `${pageProgress * 100}%`);
      document.documentElement.style.setProperty("--story-signal", `${8 + pageProgress * 84}vh`);

      scenes.forEach((scene) => {
        const rect = scene.getBoundingClientRect();
        if (rect.bottom < -viewportHeight * 0.3 || rect.top > viewportHeight * 1.3) return;

        const progress = Math.max(
          0,
          Math.min(1, (viewportHeight - rect.top) / (viewportHeight + rect.height)),
        );
        const delta = progress - 0.5;
        const focus = 1 - Math.min(1, Math.abs(delta) * 1.7);

        scene.style.setProperty("--scene-progress", String(progress));
        scene.style.setProperty("--scene-focus", String(focus));
        scene.style.setProperty("--scene-sweep", `${progress * 100}%`);
        scene.style.setProperty("--scene-clip", `${(1 - focus) * 5.5}%`);
        scene.style.setProperty("--scene-content-y", `${delta * -28 * strength}px`);
        scene.style.setProperty("--scene-y", `${delta * -96 * strength}px`);
        scene.style.setProperty("--scene-y-soft", `${delta * -50 * strength}px`);
        scene.style.setProperty("--scene-y-opposite", `${delta * 58 * strength}px`);
        scene.style.setProperty("--scene-heading-x", `${delta * -74 * strength}px`);
        scene.style.setProperty("--scene-media-y", `${delta * -44 * strength}px`);
        scene.style.setProperty("--scene-tilt", `${delta * -1.9 * strength}deg`);
        scene.style.setProperty("--scene-scale", String(1.005 + focus * 0.03));
        scene.style.setProperty("--scene-media-scale", String(1.06 - focus * 0.045));
        scene.style.setProperty("--scene-heading-scale", String(0.975 + focus * 0.025));
        scene.style.setProperty("--scene-text-opacity", String(0.7 + focus * 0.3));
        scene.style.setProperty(
          "--scene-opacity",
          String(Math.max(0.5, 1 - Math.max(0, progress - 0.72) * 1.5)),
        );
      });
    };

    const scheduleRender = () => {
      if (animationFrame) return;
      animationFrame = window.requestAnimationFrame(renderScenes);
    };

    document.documentElement.dataset.scrollFx = "true";
    scenes.forEach((scene) => scene.setAttribute("data-scroll-scene", ""));
    chapters.forEach((chapter) => chapterObserver.observe(chapter.element));
    renderScenes();

    window.addEventListener("scroll", scheduleRender, { passive: true });
    window.addEventListener("resize", scheduleRender);
  };

  document.addEventListener("astro:page-load", initScrollChoreography);
  initScrollChoreography();
</script>
